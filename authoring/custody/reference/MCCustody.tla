------------------------------ MODULE MCCustody ------------------------------
EXTENDS Custody, TLC

MCBase == [d \in Days |-> IF d <= 7 THEN A ELSE B]

MCHol == (4 :> B) @@ (11 :> A)

MCHolIdle == (2 :> A) @@ (4 :> B) @@ (11 :> A)

