# TLC error traces (regenerated by toolbox/CLI)
*_TTrace_*.tla
*_TTrace_*.bin

# TLC state-dump directories
states/

# Backup/scratch files
*.old
*.bak
*.backup
*.dump
*.cfg.test
*.cfg.backup

# Mempalace-local artifacts (config-like, regenerable)
entities.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
/issues.jsonl
_apalache-out/
*_test.cfg

# MkDocs site build (generated by scripts/build-docs.sh + mkdocs build)
/docs/
/site/

# Loom per-session ephemeral state
.claude/workflow-state.json
.claude/loom-adopt-state.json

# Git worktrees (project-local isolation)
.worktrees/
.claude/worktrees/
.claude/loom-audit-state.json

# Regenerated by the beads gate hook on every invocation, never content.
.beads.gate.lock

# harness/drill-gate.sh --changed-only's cache. One line per verified job,
# holding a key over the TLC build, verdict.sh, the item's whole verify/ tree
# and the run's flags. It is a fact about THIS box and THIS build, never
# content, and it is worthless on any other machine.
/.drill-gate-state
