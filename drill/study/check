#!/usr/bin/env bash
# check: what did TLC say about the model you wrote, and does its
# distinct-state count agree with the one the drill's prompt publishes?
#
# Delivered to the study root, with no extension, so the command reads
# `./check` or `check <slug>`.
#
# Usage:  check [<slug-or-dir>]       the default is the current directory
#         check --help
#
# Exit:   0  every module run reached a count the prompt publishes
#         1  a module did not, or TLC never got far enough to print one
#         2  UNCHECKED: the prompt publishes no count, so the count dimension
#            has nothing to compare. The run still happened and its verdict
#            is on the line
#         3  usage, no prompt found, no model found, or no tlc on the path
#
# ---------------------------------------------------------------------------
# WHAT IT ANSWERS, AND WHAT IT REFUSES TO ANSWER
#
# Two facts, with no judgment in either: what TLC's run came to, and whether
# the number TLC printed is one the prompt published. That is all. It cannot
# tell a right count reached by a wrong model from a right count reached by a
# right one, and drill/sequences/07-pneumatic-tube is the standing proof,
# where a rule true of a stack and a queue alike runs clean at the published
# figure.
#
# So a 0 from this script means the count matched and nothing more. The
# judgment half belongs to a session reading the model, which is why bead
# tla-ytv2 split the two.
#
# ---------------------------------------------------------------------------
# THE TWO DIMENSIONS ARE INDEPENDENT, AND ONLY ONE OF THEM MOVES THE EXIT CODE
#
# `count=` is the count dimension and it owns the exit code. `run=` is TLC's
# verdict on the run and it never moves the exit, because a violation is the
# RIGHT answer on some items: drill/control-state/01-slip-on-the-spike asks
# for model 1 to fail. This script knows counts. It does not know intent, and
# an exit code for VIOLATED would be it ruling on intent it cannot see.
#
# The clearest case for keeping them apart is rc 76, where TLC reports a real
# count AND fails to evaluate the invariant. `count=MATCH run=ERROR` on one
# line says both, and folding either into the other loses one of them.
#
# 43 of the 64 prompts publish a count and 21 do not (measured 2026-10-15
# over both the repo tree and the delivered one). The 21 end in a prose
# question. BEFORE BEAD tla-rzvk.1 this script read that as nothing to do and
# never started TLC, so on those 21 a session got no objective input at all --
# and all eight of drill/control-state/ are among them, every one of which
# asks for a verdict. A verdict is as checkable as a count. Now the run
# happens, `claimed=` reads the absent marker, `count=` reads NONE, and the
# exit stays 2. An absent count is never a count of zero.
#
# ---------------------------------------------------------------------------
# THE RUN VERDICT, AND THE ONE DISTINCTION IT MUST NOT BLUR
#
#   CLEAN      TLC opened no error line and printed a count
#   VIOLATED   TLC refuted something and has a trace for it: an invariant, an
#              action property, a temporal property, or a deadlock
#   ERROR      TLC opened an error line that is not a refutation
#   NOCOUNT    neither an error line this script can read nor a count
#
# VIOLATED IS DECIDED BY THE WORD "violated", never by the rc and never by the
# presence of a trace. rc 76 prints `Error: Evaluating invariant Bad failed.`
# and a full trace, and it is NOT a violation: bead tla-i9m settled that for
# harness/verdict.sh and the reason is the learner-facing one. 12 and 13 mean
# the property was checked and came out false. 75, 76 and 77 mean the check
# never happened, so nothing at all is known about whether it holds, and
# "your invariant was violated" would be a false statement about a check that
# never ran.
#
# THREE PHRASINGS carry the word, measured 2026-10-15 on TLC2
# 2026.07.31.184830:
#
#   Error: Invariant Small is violated.
#   Error: Action property NeverUp is violated.
#   Error: Temporal property Reaches was violated.
#
# so the name is read as the word before the verb rather than the word after
# a keyword that differs three ways. A deadlock is the fourth violation and
# the only one with no name, so it reports invariant=- .
#
# NOCOUNT IS THE LEFTOVER, AND IT IS DELIBERATELY NOT CLEAN. No real failure
# path measured on this build reaches it: every one opens a line with
# `Error:`, the JVM's own `Error: Could not find or load main class tlc2.TLC`
# included. It exists so that a log this script cannot read lands somewhere
# honest instead of on CLEAN, which is the one value a session will act on
# without looking.
#
# WHEN A MODULE VIOLATED, the violating state follows its line as an indented
# block. That is the LAST state of TLC's trace, not the whole trace: the first
# state is where the behavior started and says nothing about what broke.
#
# ---------------------------------------------------------------------------
# IT DEPENDS ON NOTHING BUT TLC
#
# The study tree is not this repo. There is no harness beside this file, no
# verdict.sh to source, and no repo root to resolve. Everything it needs comes
# from two environment variables with documented defaults, from the directory
# it is pointed at, and from `tlc` on the path. An absent tlc is exit 3 with a
# message, never a quiet pass.
#
#   DRILL_PROMPT_ROOT   default $HOME/tla-practice/drill
#   DRILL_STUDY_ROOT    default $HOME/Study/tla-drills
#
# RESOLUTION NEEDS NO MAPPING DATA. The slug is the basename of the study
# directory, and the prompt is the one hit of $DRILL_PROMPT_ROOT/*/<slug>/
# PROMPT.md. All 64 slugs are distinct across the eight families, so two hits
# is a bug in the tree rather than a choice to make, and this script reports
# it instead of picking one.
#
# ---------------------------------------------------------------------------
# WHERE THE NUMBER COMES FROM, WHICH IS THE LOG AND NEVER THE EXIT CODE
#
# TLC's exit code does not predict whether it printed a count, and four of the
# six classes I measured on 2026-10-15 against TLC2 2026.07.31.184830 go the
# way you would not guess:
#
#   rc    count printed?   measured against
#   ----  ---------------  --------------------------------------------
#   0     yes              drill/core/01-box-office/verify/BoxOffice
#   12    yes              drill/core/01-box-office/verify/DoubleFare
#   75    yes              drill/state-space/05-summary-record/verify/G05Record
#   150   no               drill/sets/03-ballast/verify/BallastBinary
#   255   no               drill/core/04-lift-types/verify/NegativeInConfig
#
# rc 75 is the one that catches people: G05Record logs `1 distinct states
# found` AFTER its error. So the count is read out of the log, the rc is
# printed beside it, and the two are never derived from each other.
#
# A NONZERO RC AT A MATCHING COUNT IS STILL A MATCH, and that is a decision
# rather than an oversight. drill/state-space/05-summary-record publishes a
# count for a run that errors, and deciding whether this particular prompt
# wanted this particular error means reading the prompt's prose. The rc is on
# the line for the reader. The one failure this script does gate on is TLC
# printing no count at all, which no prompt in the corpus publishes a figure
# for, so it lands on exit 1.
#
# ---------------------------------------------------------------------------
# WHICH MODULE GETS RUN
#
# Every `.tla` at the top of the directory that has a `.cfg` of the same name.
# If several qualify, each one is run and each one is reported, because Frank
# keeps variants side by side: 01-slip-on-the-spike holds pickers.tla next to
# pickers_collision.tla. Three kinds of leaving drop out, and two of them drop
# out for free:
#
#   *_TTrace_*.tla      TLC's generated trace spec, skipped by name
#   states/             TLC's fingerprint cache, never descended into
#   *.tla.old           pcal's backup, which no *.tla glob matches
#
# A module with no config of its own name is skipped too, which is what
# pickers_collision.tla actually is.
#
# NO DEADLOCK FLAG IS PASSED, on purpose. Several prompts say to check with
# deadlock checking off, and the learner says that in the config with
# CHECK_DEADLOCK. Passing `-deadlock` here would overrule the model being
# graded.
#
# ---------------------------------------------------------------------------
# THE COUNT CLAIM IN THE PROMPT, AND THE THREE SHAPES IT TAKES
#
# The claim is a SET of counts, and a module matches if TLC's number is one of
# them. A prompt that publishes a table of six runs publishes six counts, and
# this script cannot know which row you were reproducing. Printing the whole
# set is what keeps that honest: you can see what the comparison was against.
#
#   1. The prose claim, 25 prompts. "A correct model finds 129 distinct
#      states." Any integer sitting immediately before `states` or `distinct
#      states` counts, which also picks up "came back clean at 211 states"
#      and "13 distinct states, depth 7".
#
#   2. The table column, 18 prompts. A `| distinct states |` header names a
#      column, and the integers in that column are the claims. Every real
#      table carries a depth column and some carry a numeric first column, so
#      this reads the column and never the row. A blank cell is not a claim,
#      which is how a refused run is written down.
#
#   3. The continuation, 2 prompts. "81 distinct states with three troughs
#      and 168 with four" publishes two counts at two model sizes, and
#      state-space/08 runs the same shape out to four sizes. Only integers
#      after the anchor count, which is what keeps "stopped at depth 4 with 7
#      distinct states" from reading its depth as a claim.
#
# Commas are stripped before comparing, because the prompts group thousands
# (`3,531`) and TLC's own summary line does not (measured: `123457 distinct
# states found`). TLC's progress lines may group; I have not measured one on
# this build, so the reader below tolerates grouping rather than assuming its
# absence.
# ---------------------------------------------------------------------------

set -uo pipefail

PROMPT_ROOT="${DRILL_PROMPT_ROOT:-${HOME:-}/tla-practice/drill}"
STUDY_ROOT="${DRILL_STUDY_ROOT:-${HOME:-}/Study/tla-drills}"

usage() {
  cat <<'USAGE'
Usage: check [<slug-or-dir>]

  check                 check the current directory
  check <slug>          check $DRILL_STUDY_ROOT/<slug>
  check <dir>           check that directory
  check --help          this text

Exit 0 if every module reached a count the prompt publishes, 1 if one did not,
2 if the prompt publishes no count, 3 if it could not run. The run verdict is
reported either way and never moves the exit code.
USAGE
}

# ---------------------------------------------------------------------------
# The claim scan.
# ---------------------------------------------------------------------------

# prose_claims <prompt>: shapes 1 and 3 from the header. The file is flattened
# to one line first, because a claim wraps across lines in 7 of the prompts,
# then split into sentences so a continuation cannot reach past the sentence
# that anchored it.
prose_claims() {
  local norm sentences sentence anchors rest conts hit num out=""
  local nl=$'\n'
  norm="$(tr '\n' ' ' <"$1")"
  norm="$(tr -s ' ' <<<"$norm")"
  # One sentence per line, splitting on ". " alone, so a decimal inside a
  # figure like "1.2 seconds" does not open a sentence of its own.
  sentences="${norm//. /.${nl}}"
  while IFS= read -r sentence; do
    anchors="$(grep -oE '[0-9][0-9,]*[[:space:]]+(distinct[[:space:]]+)?states' <<<"$sentence")"
    [ -n "$anchors" ] || continue
    while IFS= read -r hit; do
      [ -n "$hit" ] || continue
      num="$(grep -oE '^[0-9][0-9,]*' <<<"$hit")"
      out="${out}$(tr -d ',' <<<"$num") "
    done <<<"$anchors"
    # Shape 3. Everything up to the first `states` is dropped, so only an
    # integer AFTER the anchor can be read as a further model size.
    rest="${sentence#*states}"
    conts="$(grep -oE '[0-9][0-9,]*[[:space:]]+with([[:space:]]|$)' <<<"$rest")"
    [ -n "$conts" ] || continue
    while IFS= read -r hit; do
      [ -n "$hit" ] || continue
      num="$(grep -oE '^[0-9][0-9,]*' <<<"$hit")"
      out="${out}$(tr -d ',' <<<"$num") "
    done <<<"$conts"
  done <<<"$sentences"
  printf '%s' "$out"
}

# table_claims <prompt>: shape 2. The header row names a column by index and
# every following row is read at that index alone. A line that does not start
# with a pipe ends the table, which is what lets a prompt carry three of them
# at three different column positions (state-space/03 does).
table_claims() {
  local line col idx cell out=""
  col=""
  while IFS= read -r line; do
    case "$line" in
    '|'*)
      if [ -z "$col" ]; then
        idx=0
        while IFS= read -r cell; do
          idx=$((idx + 1))
          case "$cell" in
          *distinct*states*) col="$idx" ;;
          esac
        done < <(tr '|' '\n' <<<"$line")
      else
        idx=0
        while IFS= read -r cell; do
          idx=$((idx + 1))
          if [ "$idx" = "$col" ]; then
            cell="$(tr -d ' ,' <<<"$cell")"
            case "$cell" in
            '' | *[!0-9]*) : ;;
            *) out="${out}${cell} " ;;
            esac
          fi
        done < <(tr '|' '\n' <<<"$line")
      fi
      ;;
    *) col="" ;;
    esac
  done <"$1"
  printf '%s' "$out"
}

# dedupe_csv <space-separated>: the claim is a set, so a table that publishes
# the same count three times (modules/02 does) claims it once.
dedupe_csv() {
  local -a toks=()
  local tok seen=" " out=""
  read -r -a toks <<<"$1"
  for tok in ${toks[@]+"${toks[@]}"}; do
    case "$seen" in
    *" ${tok} "*) continue ;;
    esac
    seen="${seen}${tok} "
    out="${out:+${out},}${tok}"
  done
  printf '%s' "$out"
}

# ---------------------------------------------------------------------------
# The run.
# ---------------------------------------------------------------------------

# last_count <tlc output>: the number TLC printed, or nothing. The LAST match
# wins, because a long run reports progress on the same words before it
# reaches its summary.
last_count() {
  local hits
  hits="$(grep -oE '[0-9][0-9,]*[[:space:]]+distinct[[:space:]]+states[[:space:]]+found' <<<"$1")"
  [ -n "$hits" ] || return 0
  hits="$(tail -n 1 <<<"$hits")"
  hits="$(grep -oE '^[0-9][0-9,]*' <<<"$hits")"
  tr -d ',' <<<"$hits"
}

# claim_matches <count> <csv>
claim_matches() {
  local one
  while IFS= read -r one; do
    [ "$one" = "$1" ] && return 0
  done < <(tr ',' '\n' <<<"$2")
  return 1
}

# violated_name <tlc output>: the name TLC said was violated, or nothing.
#
# The three phrasings in the header agree on the verb and disagree on the
# keyword, so the name is the last word before `is violated` or `was
# violated`. Every pattern here is anchored at the line start, because the
# counterexample below `Error: The behavior up to this point is:` prints the
# learner's own state values and those can hold any text at all.
violated_name() {
  local hits line
  hits="$(grep -oE '^Error: .+[[:space:]](is|was)[[:space:]]+violated' <<<"$1")"
  [ -n "$hits" ] || return 0
  line="$(head -n 1 <<<"$hits")"
  line="${line% violated}"
  line="${line% is}"
  line="${line% was}"
  printf '%s' "${line##* }"
}

# deadlocked <tlc output>: a reachable state with no successor. Measured
# `Error: Deadlock reached.` at rc 11. It is a violation with a trace and with
# no name to give, so it is the one shape that leaves invariant= at the marker
# on a violated run.
deadlocked() {
  grep -qE '^Error: Deadlock reached' <<<"$1"
}

# tlc_errored <tlc output>: TLC opened a line with `Error: `. Asked only after
# the two refutation questions above, so the trace header `Error: The behavior
# up to this point is:` never decides anything on its own.
tlc_errored() {
  grep -qE '^Error:' <<<"$1"
}

# violating_state <tlc output>: the LAST state of TLC's trace.
#
# A block opens with `State <n>: <where>` at column 0 and runs until a line
# that is not part of a value. Stopping at a blank line alone is not enough:
# a liveness counterexample ends `State 4: Stuttering` with no body at all and
# TLC's next chatter line immediately under it, which a blank-line reader
# swallows into the state. So a body line is recognized rather than a
# terminator -- a `/\` conjunct, an indented continuation of a value that
# wrapped, or `name = value` -- and anything else ends the block.
violating_state() {
  local line block="" collecting=0 nl=$'\n'
  while IFS= read -r line; do
    case "$line" in
    'State '[0-9]*':'*)
      block="$line"
      collecting=1
      continue
      ;;
    esac
    [ "$collecting" = 1 ] || continue
    case "$line" in
    '') collecting=0 ;;
    '/'* | ' '* | *' = '*) block="${block}${nl}${line}" ;;
    *) collecting=0 ;;
    esac
  done <<<"$1"
  printf '%s' "$block"
}

# ---------------------------------------------------------------------------
# Resolve what to check.
# ---------------------------------------------------------------------------

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
esac

if [ "$#" -gt 1 ]; then
  echo "check: one argument at most, got $#." >&2
  usage >&2
  exit 3
fi

TARGET="${1:-}"
if [ -z "$TARGET" ]; then
  WORK="$PWD"
  SLUG="$(basename -- "$PWD")"
elif [ -d "$TARGET" ]; then
  WORK="$(cd -- "$TARGET" && pwd)"
  SLUG="$(basename -- "$WORK")"
elif [ "${TARGET#*/}" != "$TARGET" ]; then
  # It carries a slash, so it was meant as a path and the path is not there.
  WORK="$TARGET"
  SLUG="$(basename -- "$TARGET")"
else
  WORK="${STUDY_ROOT}/${TARGET}"
  SLUG="$TARGET"
fi

# ---------------------------------------------------------------------------
# Resolve the prompt. Two hits is a corpus bug and gets reported as one.
# ---------------------------------------------------------------------------

HITS=()
for candidate in "$PROMPT_ROOT"/*/"$SLUG"/PROMPT.md; do
  [ -f "$candidate" ] && HITS+=("$candidate")
done

if [ "${#HITS[@]}" -eq 0 ]; then
  echo "check: no prompt for '${SLUG}'. Looked for ${PROMPT_ROOT}/*/${SLUG}/PROMPT.md." >&2
  exit 3
fi
if [ "${#HITS[@]}" -gt 1 ]; then
  echo "check: '${SLUG}' matches ${#HITS[@]} prompts. That is a corpus bug, not a choice to make:" >&2
  for candidate in "${HITS[@]}"; do
    echo "  ${candidate}" >&2
  done
  exit 3
fi
PROMPT="${HITS[0]}"

# ---------------------------------------------------------------------------
# The claim. No claim is still exit 2, but it NO LONGER SHORT-CIRCUITS the
# run, which is the whole of bead tla-rzvk.1. It used to return here, before
# asking for a model or for tlc, and that cost a session every objective fact
# about the run on 21 of the 64 prompts. The claim becomes the absent marker,
# the count verdict becomes NONE, and the exit is decided at the bottom.
#
# A consequence worth stating, because it moved an exit code: a no-claim
# prompt with no tlc on the path is now 3 rather than 2. The run is the
# deliverable on these prompts, so being unable to run it is "could not run".
# Exit 2 keeps its meaning. What changed is that it's no longer reached by
# declining to look.
# ---------------------------------------------------------------------------

CLAIMS="$(dedupe_csv "$(prose_claims "$PROMPT")$(table_claims "$PROMPT")")"

NOCLAIM=""
if [ -z "$CLAIMS" ]; then
  NOCLAIM=1
  CLAIMS="-"
fi

# ---------------------------------------------------------------------------
# The models, then the toolchain.
# ---------------------------------------------------------------------------

if [ ! -d "$WORK" ]; then
  echo "check: ${WORK} is not a directory, so there is no model to run." >&2
  exit 3
fi

MODULES=()
for candidate in "$WORK"/*.tla; do
  [ -f "$candidate" ] || continue
  base="${candidate##*/}"
  base="${base%.tla}"
  case "$base" in
  *_TTrace_*) continue ;;
  esac
  [ -f "${WORK}/${base}.cfg" ] || continue
  MODULES+=("$base")
done

if [ "${#MODULES[@]}" -eq 0 ]; then
  echo "check: no module with a config of the same name under ${WORK}." >&2
  exit 3
fi

if ! command -v tlc >/dev/null 2>&1; then
  echo "check: tlc is not on the path, so nothing was checked." >&2
  exit 3
fi

# ---------------------------------------------------------------------------
# Run each model and report it.
# ---------------------------------------------------------------------------

MISSED=()
for module in "${MODULES[@]}"; do
  out="$(cd -- "$WORK" && tlc -config "${module}.cfg" "$module" 2>&1)"
  rc=$?

  # The count dimension.
  count="$(last_count "$out")"
  shown="${count:--}"
  if [ -n "$NOCLAIM" ]; then
    verdict="NONE"
  elif [ -z "$count" ]; then
    verdict="MISMATCH"
  elif claim_matches "$count" "$CLAIMS"; then
    verdict="MATCH"
  else
    verdict="MISMATCH"
  fi

  # The run dimension. The order is the precedence: a refutation this script
  # can name, then one it cannot, then any other error, then the two ways a
  # run with no error ends. Nothing here reads rc, which does not predict
  # either answer.
  name="$(violated_name "$out")"
  if [ -n "$name" ]; then
    run="VIOLATED"
  elif deadlocked "$out"; then
    run="VIOLATED"
    name="-"
  elif tlc_errored "$out"; then
    run="ERROR"
    name="-"
  elif [ -n "$count" ]; then
    run="CLEAN"
    name="-"
  else
    run="NOCOUNT"
    name="-"
  fi

  printf 'module=%s rc=%s distinct=%s claimed=%s count=%s run=%s invariant=%s\n' \
    "$module" "$rc" "$shown" "$CLAIMS" "$verdict" "$run" "$name"

  if [ "$run" = "VIOLATED" ]; then
    state="$(violating_state "$out")"
    if [ -n "$state" ]; then
      while IFS= read -r stateline; do
        printf '  %s\n' "$stateline"
      done <<<"$state"
    fi
  fi

  [ "$verdict" = "MISMATCH" ] && MISSED+=("$module")
done

if [ -n "$NOCLAIM" ]; then
  printf 'UNCHECKED: %s publishes no distinct-state count, so nothing was compared. The run verdict on each line above still came from TLC.\n' "$SLUG"
  exit 2
fi

if [ "${#MISSED[@]}" -eq 0 ]; then
  printf 'MATCHED: %s of %s module(s) reached a count %s publishes.\n' \
    "${#MODULES[@]}" "${#MODULES[@]}" "$SLUG"
  exit 0
fi

printf 'MISMATCHED: %s of %s module(s) did not reach a count %s publishes: %s\n' \
  "${#MISSED[@]}" "${#MODULES[@]}" "$SLUG" "${MISSED[*]}"
exit 1
