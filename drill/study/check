#!/usr/bin/env bash
# check: what did TLC say about the model you wrote, and does its
# distinct-state count agree with the one the drill's prompt publishes?
#
# Delivered to the study root, with no extension, so the command reads
# `./check` or `check <slug>`.
#
# Usage:  check [<slug-or-dir>]       the default is the current directory
#         check --help
#
# Exit:   0  every module run reached a count the prompt publishes
#         1  a module did not, or TLC never got far enough to print one
#         2  UNCHECKED: the prompt publishes no count, so the count dimension
#            has nothing to compare. The run still happened and its verdict
#            is on the line
#         3  usage, no prompt found, no model found, no tlc on the path, or no
#            scratch directory to run TLC in
#
# ---------------------------------------------------------------------------
# WHAT IT ANSWERS, AND WHAT IT REFUSES TO ANSWER
#
# Two facts, with no judgment in either: what TLC's run came to, and whether
# the number TLC printed is one the prompt published. That is all. It cannot
# tell a right count reached by a wrong model from a right count reached by a
# right one, and drill/sequences/07-pneumatic-tube is the standing proof,
# where a rule true of a stack and a queue alike runs clean at the published
# figure.
#
# So a 0 from this script means the count matched and nothing more. The
# judgment half belongs to a session reading the model, which is why bead
# tla-ytv2 split the two.
#
# ---------------------------------------------------------------------------
# THE DIMENSIONS ARE INDEPENDENT, AND ONLY ONE OF THEM MOVES THE EXIT CODE
#
# Two of them are older than the rubric and this section is about those two.
# The three the rubric adds have their own section below, and the rule there
# is the rule here: `count=` owns the exit and nothing else touches it.
#
# `count=` is the count dimension and it owns the exit code. `run=` is TLC's
# verdict on the run and it never moves the exit, because a violation is the
# RIGHT answer on some items: drill/control-state/01-slip-on-the-spike asks
# for model 1 to fail. This script knows counts. It does not know intent, and
# an exit code for VIOLATED would be it ruling on intent it cannot see.
#
# The clearest case for keeping them apart is rc 76, where TLC reports a real
# count AND fails to evaluate the invariant. `count=MATCH run=ERROR` on one
# line says both, and folding either into the other loses one of them.
#
# 43 of the 64 prompts publish a count and 21 do not (measured 2026-10-15
# over both the repo tree and the delivered one). The 21 end in a prose
# question. BEFORE BEAD tla-rzvk.1 this script read that as nothing to do and
# never started TLC, so on those 21 a session got no objective input at all --
# and all eight of drill/control-state/ are among them, every one of which
# asks for a verdict. A verdict is as checkable as a count. Now the run
# happens, `claimed=` reads the absent marker, `count=` reads NONE, and the
# exit stays 2. An absent count is never a count of zero.
#
# ---------------------------------------------------------------------------
# THE RUN VERDICT, AND THE ONE DISTINCTION IT MUST NOT BLUR
#
#   CLEAN      TLC opened no error line and printed a count
#   VIOLATED   TLC refuted something and has a trace for it: an invariant, an
#              action property, a temporal property, or a deadlock
#   ERROR      TLC opened an error line that is not a refutation
#   NOCOUNT    neither an error line this script can read nor a count
#
# VIOLATED IS DECIDED BY THE WORD "violated", never by the rc and never by the
# presence of a trace. rc 76 prints `Error: Evaluating invariant Bad failed.`
# and a full trace, and it is NOT a violation: bead tla-i9m settled that for
# harness/verdict.sh and the reason is the learner-facing one. 12 and 13 mean
# the property was checked and came out false. 75, 76 and 77 mean the check
# never happened, so nothing at all is known about whether it holds, and
# "your invariant was violated" would be a false statement about a check that
# never ran.
#
# THREE PHRASINGS carry the word, measured 2026-10-15 on TLC2
# 2026.07.31.184830:
#
#   Error: Invariant Small is violated.
#   Error: Action property NeverUp is violated.
#   Error: Temporal property Reaches was violated.
#
# so the name is read as the word before the verb rather than the word after
# a keyword that differs three ways. A deadlock is the fourth violation and
# the only one with no name, so it reports invariant=- .
#
# NOCOUNT IS THE LEFTOVER, AND IT IS DELIBERATELY NOT CLEAN. No real failure
# path measured on this build reaches it: every one opens a line with
# `Error:`, the JVM's own `Error: Could not find or load main class tlc2.TLC`
# included. It exists so that a log this script cannot read lands somewhere
# honest instead of on CLEAN, which is the one value a session will act on
# without looking.
#
# WHEN A MODULE VIOLATED, the violating state follows its line as an indented
# block. That is the LAST state of TLC's trace, not the whole trace: the first
# state is where the behavior started and says nothing about what broke.
#
# ---------------------------------------------------------------------------
# IT DEPENDS ON NOTHING BUT TLC
#
# The study tree is not this repo. There is no harness beside this file, no
# verdict.sh to source, and no repo root to resolve. Everything it needs comes
# from two environment variables with documented defaults, from the directory
# it is pointed at, and from `tlc` on the path. An absent tlc is exit 3 with a
# message, never a quiet pass. The only other tools it reaches for are mktemp
# and cp, for the copy the next section is about.
#
#   DRILL_PROMPT_ROOT   default $HOME/tla-practice/drill
#   DRILL_STUDY_ROOT    default $HOME/Study/tla-drills
#   DRILL_REPO_ROOT     default unset. The rubric's only other home
#
# DRILL_REPO_ROOT UNSET IS `rubric=none` AND NOT A FAILURE, which is the same
# posture drill/drill.sh takes about its refutation table (drill/drill.sh:
# 345-360). An unset root keeps this script working on a box holding nothing
# but the practice tree, and the richer report is opt-in on the box that has
# the repo.
#
# ---------------------------------------------------------------------------
# THE RUBRIC, AND THE THREE DIMENSIONS THAT NEVER MOVE THE EXIT CODE
#
# An item may declare what a reasonable model of it does, in four fields that
# name no construct and no variable: `runs`, `fault`, `states` and
# `obligations`. drill/study/CLAUDE.md carries the schema and the reason for
# each field. This script compares a run against the first three and reports
# the comparison beside the two dimensions it already had.
#
#   rubric-runs    MET, UNMET or -     did TLC get off the ground as declared
#   rubric-fault   MET, UNMET,         did the declared fault fire, and only it
#                  UNKNOWN or -
#   rubric-states  IN, OUT or -        is the distinct count inside the envelope
#
# NONE OF THE THREE MOVES THE EXIT CODE. `count=` still owns it, for the same
# reason `run=` never did: a rubric verdict is a statement about what the item
# declared, and folding one into the exit would be this script ruling on
# intent. An UNMET fault is the RIGHT answer on an item asking for a
# violation, and the rubric is what says which item that is -- but the
# instrument that acts on it is a session reading the report.
#
# UNKNOWN IS THE HONEST FAULT VERDICT WHEN THE RUN NEVER REACHED AN
# OBLIGATION. rc 75, 76 and 77 mean the check did not happen, so nothing is
# known about whether anything holds, and MET or UNMET would both be a claim
# about a check that never ran. That is the same distinction `run=ERROR`
# already draws against VIOLATED, arriving one dimension over.
#
# WHERE IT IS READ FROM, IN THIS ORDER. The prompt first, because `runs`,
# `fault`, `states` and `obligations` are the DELIVERED half of the rubric and
# a prompt that carries them needs nothing else. Then the item's META.md under
# $DRILL_REPO_ROOT, which is where the fields live until bead tla-sqym.4 moves
# them into the prompts. `rubric=` names which one answered, so a reader can
# tell a rubric this script never found from an item that ships none.
#
# A `-` ON ALL THREE IS NOT A PASS AND NOT A FAILURE. 8 of the 64 items carry
# a rubric today, all of them in the sets family, so `rubric=none` is the
# common case and bead tla-sqym.2 is what changes that.
#
# ---------------------------------------------------------------------------
# IT WRITES NOTHING IN THE DIRECTORY IT IS CHECKING, AND THAT TOOK A FIX
#
# TLC writes in whatever directory it runs in, and until bead tla-9y5h this
# script ran it in the work directory. So a violated run left a trace module, a
# .bin and a states/ fingerprint cache beside the spec, and a clean run left
# the states/ cache. The study tree holds the only copy of Frank's work and has
# no git behind it, and scripts/deliver-drill.sh prints "left alone (your work,
# never written here):" about that tree while it delivers.
#
# MEASURED TWICE IN ~/Study/tla-drills/01-slip-on-the-spike, on 2026-10-14 and
# again on 2026-10-15, both times by the session that was holding the bead
# open. One check left pickers_collision_TTrace_1792036425.tla, its .bin, and
# states/26-10-14-23-53-45.700/. The names carry a timestamp, so nothing
# overwrites at any spacing a person works at and twenty checks leave twenty
# pairs.
#
# WHAT IT DOES INSTEAD is copy the directory's modules and configs into a
# scratch directory of its own, run TLC there, read the log and delete the
# copy. EVERY module goes across rather than only the one being run, because a
# module another one EXTENDS has to sit beside it or the run fails at the
# parse. drill/study/style already had this property for free, since it reads
# text and never starts TLC.
#
# THIS CHANGED WHAT THE *_TTrace_* SKIP BELOW IS FOR, and the skip is no less
# load-bearing for it. Bead tla-rzvk.4 made the skip carry weight because a
# trace leaving is itself an unpaired module, so without it the leaving borrows
# the directory's config and gets checked as though Frank had written it. What
# changed is where the leavings came from: this script was generating the exact
# shape its own borrowing rule had to special-case. Now the skip guards only
# what TLC left there BEFORE, from a hand run or an older session, which is
# what it was always for.
#
# RESOLUTION NEEDS NO MAPPING DATA. The slug is the basename of the study
# directory, and the prompt is the one hit of $DRILL_PROMPT_ROOT/*/<slug>/
# PROMPT.md. All 64 slugs are distinct across the eight families, so two hits
# is a bug in the tree rather than a choice to make, and this script reports
# it instead of picking one.
#
# ---------------------------------------------------------------------------
# WHERE THE NUMBER COMES FROM, WHICH IS THE LOG AND NEVER THE EXIT CODE
#
# TLC's exit code does not predict whether it printed a count, and four of the
# six classes I measured on 2026-10-15 against TLC2 2026.07.31.184830 go the
# way you would not guess:
#
#   rc    count printed?   measured against
#   ----  ---------------  --------------------------------------------
#   0     yes              drill/core/01-box-office/verify/BoxOffice
#   12    yes              drill/core/01-box-office/verify/DoubleFare
#   75    yes              drill/state-space/05-summary-record/verify/G05Record
#   150   no               drill/sets/03-ballast/verify/BallastBinary
#   255   no               drill/core/04-lift-types/verify/NegativeInConfig
#
# rc 75 is the one that catches people: G05Record logs `1 distinct states
# found` AFTER its error. So the count is read out of the log, the rc is
# printed beside it, and the two are never derived from each other.
#
# A NONZERO RC AT A MATCHING COUNT IS STILL A MATCH, and that is a decision
# rather than an oversight. drill/state-space/05-summary-record publishes a
# count for a run that errors, and deciding whether this particular prompt
# wanted this particular error means reading the prompt's prose. The rc is on
# the line for the reader. The one failure this script does gate on is TLC
# printing no count at all, which no prompt in the corpus publishes a figure
# for, so it lands on exit 1.
#
# ---------------------------------------------------------------------------
# WHICH MODULE GETS RUN, AND WITH WHOSE CONFIG
#
# Every `.tla` at the top of the directory, less three kinds of leaving, two
# of which drop out for free:
#
#   *_TTrace_*.tla      TLC's generated trace spec, skipped by name
#   states/             TLC's fingerprint cache, never descended into
#   *.tla.old           pcal's backup, which no *.tla glob matches
#
# THE TRACE SKIP EARNS ITS KEEP NOW THAT CONFIGS ARE SHARED. Measured on this
# build 2026-10-14: a run that violates writes Foo_TTrace_<n>.tla and no
# config beside it. So TLC's own trace spec is itself an unpaired module, and
# without the name skip it would borrow the directory's config and get checked
# as though Frank had written it. The skip applies to the config side for the
# same reason.
#
# WHAT IT GUARDS IS NO LONGER THIS SCRIPT'S OWN MESS. Bead tla-9y5h moved the
# run into a scratch copy, so the leavings reaching this glob are the ones TLC
# left before, from a hand run of tlc or an older session. See the section on
# the copy above.
#
# A module with a `.cfg` of its own name runs with that one. A module without
# one runs with the directory's config when all three of these hold:
#
#   1. exactly one config sits beside it, trace leavings not counted
#   2. that config says what to run, through SPECIFICATION or INIT and NEXT
#   3. the module defines every name it gave
#
# ONE CONFIG FOR TWO MODULES IS FRANK'S WORKFLOW rather than an oversight, and
# that is the whole reason borrowing exists. The control-state family and
# several others ask for two models: write it, run it, change one thing, run
# it again. The second model declares the same constants and the same
# invariants, so the first model's config is valid for it. What he ran by hand
# was `tlc -config pickers.cfg pickers_collision`.
#
# BEFORE BEAD tla-rzvk.4 this script dropped that second model with no mention
# at all. On his first drill, 2026-10-14, it reported one CLEAN module and
# never named the one with the defect in it. That is a false reassurance from
# the one tool in this loop whose job is to be objective.
#
# CONDITION 3 IS WHAT KEEPS THIS FROM GUESSING. A helper module that another
# module EXTENDS is unpaired too, and handing it a config would run TLC over a
# library rather than over a spec. The test is one grep for the operator the
# config named, so a module that does not answer to that config never gets it.
# A module that inherits the operator through an EXTENDS reads as not defining
# it and lands in the unrun report. That is the conservative direction, and I
# would rather be wrong in it than run a check nobody asked for.
#
# ANYTHING THAT FAILS A CONDITION IS NAMED, NOT RUN, AND CARRIES ITS REASON:
#
#   module=Variant NOT RUN: no Variant.cfg, and 2 configs to choose from: ...
#   module=Helper NOT RUN: does not define Spec, which pickers.cfg names
#
# "Not run" with no reason would send Frank looking for a config he already
# has, or writing a duplicate one he has no reason to keep.
#
# THE CONFIG IS ON EVERY MODULE LINE, borrowed or not. Printing it only when
# it was borrowed would leave the fact in a silence, and a reader would have
# to know this rule to read the output. That is the defect this bead fixes,
# arriving one level up.
#
# AN UNRUN MODULE DOES NOT MOVE THE EXIT CODE, and a borrowed run counts as
# any other run does. The count dimension still owns the exit, and an unrun
# module is a report in the sense `run=` is.
#
# NO DEADLOCK FLAG IS PASSED, on purpose. Several prompts say to check with
# deadlock checking off, and the learner says that in the config with
# CHECK_DEADLOCK. Passing `-deadlock` here would overrule the model being
# graded.
#
# ---------------------------------------------------------------------------
# THE COUNT CLAIM IN THE PROMPT, AND THE THREE SHAPES IT TAKES
#
# The claim is a SET of counts, and a module matches if TLC's number is one of
# them. A prompt that publishes a table of six runs publishes six counts, and
# this script cannot know which row you were reproducing. Printing the whole
# set is what keeps that honest: you can see what the comparison was against.
#
#   1. The prose claim, 25 prompts. "A correct model finds 129 distinct
#      states." Any integer sitting immediately before `states` or `distinct
#      states` counts, which also picks up "came back clean at 211 states"
#      and "13 distinct states, depth 7".
#
#   2. The table column, 18 prompts. A `| distinct states |` header names a
#      column, and the integers in that column are the claims. Every real
#      table carries a depth column and some carry a numeric first column, so
#      this reads the column and never the row. A blank cell is not a claim,
#      which is how a refused run is written down.
#
#   3. The continuation, 2 prompts. "81 distinct states with three troughs
#      and 168 with four" publishes two counts at two model sizes, and
#      state-space/08 runs the same shape out to four sizes. Only integers
#      after the anchor count, which is what keeps "stopped at depth 4 with 7
#      distinct states" from reading its depth as a claim.
#
# Commas are stripped before comparing, because the prompts group thousands
# (`3,531`) and TLC's own summary line does not (measured: `123457 distinct
# states found`). TLC's progress lines may group; I have not measured one on
# this build, so the reader below tolerates grouping rather than assuming its
# absence.
# ---------------------------------------------------------------------------

set -uo pipefail

PROMPT_ROOT="${DRILL_PROMPT_ROOT:-${HOME:-}/tla-practice/drill}"
STUDY_ROOT="${DRILL_STUDY_ROOT:-${HOME:-}/Study/tla-drills}"
REPO_ROOT="${DRILL_REPO_ROOT:-}"

usage() {
  cat <<'USAGE'
Usage: check [<slug-or-dir>]

  check                 check the current directory
  check <slug>          check $DRILL_STUDY_ROOT/<slug>
  check <dir>           check that directory
  check --help          this text

Exit 0 if every module reached a count the prompt publishes, 1 if one did not,
2 if the prompt publishes no count, 3 if it could not run. The run verdict and
the three rubric verdicts are reported either way and never move the exit code.
USAGE
}

# ---------------------------------------------------------------------------
# The claim scan.
# ---------------------------------------------------------------------------

# prose_claims <prompt>: shapes 1 and 3 from the header. The file is flattened
# to one line first, because a claim wraps across lines in 7 of the prompts,
# then split into sentences so a continuation cannot reach past the sentence
# that anchored it.
prose_claims() {
  local norm sentences sentence anchors rest conts hit num out=""
  local nl=$'\n'
  norm="$(tr '\n' ' ' <"$1")"
  norm="$(tr -s ' ' <<<"$norm")"
  # One sentence per line, splitting on ". " alone, so a decimal inside a
  # figure like "1.2 seconds" does not open a sentence of its own.
  sentences="${norm//. /.${nl}}"
  while IFS= read -r sentence; do
    anchors="$(grep -oE '[0-9][0-9,]*[[:space:]]+(distinct[[:space:]]+)?states' <<<"$sentence")"
    [ -n "$anchors" ] || continue
    while IFS= read -r hit; do
      [ -n "$hit" ] || continue
      num="$(grep -oE '^[0-9][0-9,]*' <<<"$hit")"
      out="${out}$(tr -d ',' <<<"$num") "
    done <<<"$anchors"
    # Shape 3. Everything up to the first `states` is dropped, so only an
    # integer AFTER the anchor can be read as a further model size.
    rest="${sentence#*states}"
    conts="$(grep -oE '[0-9][0-9,]*[[:space:]]+with([[:space:]]|$)' <<<"$rest")"
    [ -n "$conts" ] || continue
    while IFS= read -r hit; do
      [ -n "$hit" ] || continue
      num="$(grep -oE '^[0-9][0-9,]*' <<<"$hit")"
      out="${out}$(tr -d ',' <<<"$num") "
    done <<<"$conts"
  done <<<"$sentences"
  printf '%s' "$out"
}

# table_claims <prompt>: shape 2. The header row names a column by index and
# every following row is read at that index alone. A line that does not start
# with a pipe ends the table, which is what lets a prompt carry three of them
# at three different column positions (state-space/03 does).
table_claims() {
  local line col idx cell out=""
  col=""
  while IFS= read -r line; do
    case "$line" in
    '|'*)
      if [ -z "$col" ]; then
        idx=0
        while IFS= read -r cell; do
          idx=$((idx + 1))
          case "$cell" in
          *distinct*states*) col="$idx" ;;
          esac
        done < <(tr '|' '\n' <<<"$line")
      else
        idx=0
        while IFS= read -r cell; do
          idx=$((idx + 1))
          if [ "$idx" = "$col" ]; then
            cell="$(tr -d ' ,' <<<"$cell")"
            case "$cell" in
            '' | *[!0-9]*) : ;;
            *) out="${out}${cell} " ;;
            esac
          fi
        done < <(tr '|' '\n' <<<"$line")
      fi
      ;;
    *) col="" ;;
    esac
  done <"$1"
  printf '%s' "$out"
}

# dedupe_csv <space-separated>: the claim is a set, so a table that publishes
# the same count three times (modules/02 does) claims it once.
dedupe_csv() {
  local -a toks=()
  local tok seen=" " out=""
  read -r -a toks <<<"$1"
  for tok in ${toks[@]+"${toks[@]}"}; do
    case "$seen" in
    *" ${tok} "*) continue ;;
    esac
    seen="${seen}${tok} "
    out="${out:+${out},}${tok}"
  done
  printf '%s' "$out"
}

# ---------------------------------------------------------------------------
# What a config says to run, and whether a module answers to it.
# ---------------------------------------------------------------------------

# config_runs <cfg>: the operator names the config says to run, one per line,
# or nothing when it names none this script can read.
#
# SPECIFICATION gives one name. INIT and NEXT give two and both have to be
# there, since a config carrying only one of them runs nothing either. 53 of
# the 337 configs in the survey in .claude/rules/tla-practice.md use the
# INIT/NEXT form, so a reader that only knows SPECIFICATION misreads a sixth
# of them as naming nothing at all.
#
# The file is read as a token stream rather than line by line, because TLC
# lets a keyword and its name sit on separate lines. `\*` opens a comment to
# the end of the line here exactly as it does inside a module.
config_runs() {
  local tok want="" spec="" init="" nxt=""
  while read -r tok; do
    [ -n "$tok" ] || continue
    case "$want" in
    SPEC)
      spec="$tok"
      want=""
      continue
      ;;
    INIT)
      init="$tok"
      want=""
      continue
      ;;
    NEXT)
      nxt="$tok"
      want=""
      continue
      ;;
    esac
    case "$tok" in
    SPECIFICATION) want=SPEC ;;
    INIT) want=INIT ;;
    NEXT) want=NEXT ;;
    esac
  done < <(sed 's/\\\*.*//' "$1" | tr -s '[:space:]' '\n')
  if [ -n "$spec" ]; then
    printf '%s\n' "$spec"
    return 0
  fi
  if [ -n "$init" ] && [ -n "$nxt" ]; then
    printf '%s\n%s\n' "$init" "$nxt"
  fi
}

# defines_all <module.tla> <name>...: does the module define every operator
# named? A definition opens a line with the name and `==`, so the pattern is
# anchored at the line start and the name has to be the whole token.
#
# ITS LIMIT IS WORTH STATING. A module that gets the operator from an EXTENDS
# instead of defining it reads here as not defining it, and falls to the unrun
# report. Following the EXTENDS would be a second parser and a guess at what
# resolves, and the cost of being wrong this way is a line Frank can read and
# act on. The cost of being wrong the other way is TLC run over a library.
defines_all() {
  local module="$1" name
  shift
  for name in "$@"; do
    grep -qE "^[[:space:]]*${name}[[:space:]]*==" "$module" || return 1
  done
  return 0
}

# ---------------------------------------------------------------------------
# The run.
# ---------------------------------------------------------------------------

# last_count <tlc output>: the number TLC printed, or nothing. The LAST match
# wins, because a long run reports progress on the same words before it
# reaches its summary.
last_count() {
  local hits
  hits="$(grep -oE '[0-9][0-9,]*[[:space:]]+distinct[[:space:]]+states[[:space:]]+found' <<<"$1")"
  [ -n "$hits" ] || return 0
  hits="$(tail -n 1 <<<"$hits")"
  hits="$(grep -oE '^[0-9][0-9,]*' <<<"$hits")"
  tr -d ',' <<<"$hits"
}

# claim_matches <count> <csv>
claim_matches() {
  local one
  while IFS= read -r one; do
    [ "$one" = "$1" ] && return 0
  done < <(tr ',' '\n' <<<"$2")
  return 1
}

# violated_name <tlc output>: the name TLC said was violated, or nothing.
#
# The three phrasings in the header agree on the verb and disagree on the
# keyword, so the name is the last word before `is violated` or `was
# violated`. Every pattern here is anchored at the line start, because the
# counterexample below `Error: The behavior up to this point is:` prints the
# learner's own state values and those can hold any text at all.
violated_name() {
  local hits line
  hits="$(grep -oE '^Error: .+[[:space:]](is|was)[[:space:]]+violated' <<<"$1")"
  [ -n "$hits" ] || return 0
  line="$(head -n 1 <<<"$hits")"
  line="${line% violated}"
  line="${line% is}"
  line="${line% was}"
  printf '%s' "${line##* }"
}

# violated_kind <tlc output>: which of the rubric's `fault` values TLC's
# violation line names, or nothing when there is no violation line.
#
# THE KEYWORD IS WHAT THIS READS, where violated_name above reads the name. It
# is the one place the three phrasings in the header have to be told apart
# rather than merged: `Invariant` is the rubric's `invariant`, and both
# `Action property` and `Temporal property` are its `property`.
#
# 12 AND 13 DO NOT DECIDE IT, and neither does the .cfg keyword. A formula
# like `[](P => []P)` is safety written with temporal operators and TLC calls
# it an invariant, so an item whose requirement is safety declares
# `fault: invariant` however the formula is spelled. Reading the rc here would
# get that case wrong (harness/verdict.sh:81-91).
#
# Capture first, then a here-string into head. A live pipe into head returns
# 141 under pipefail, and inside an `if` that reads as "no violation".
violated_kind() {
  local hits line
  hits="$(grep -oE '^Error: (Invariant|Action property|Temporal property) ' <<<"$1")"
  [ -n "$hits" ] || return 0
  line="$(head -n 1 <<<"$hits")"
  case "$line" in
  'Error: Invariant '*) printf 'invariant' ;;
  'Error: Action property '* | 'Error: Temporal property '*) printf 'property' ;;
  esac
}

# ---------------------------------------------------------------------------
# rubric_read <file>: a `## Rubric` section's four delivered fields, into
# globals. RB_PRESENT is 1 when the file carries the heading at all.
#
# THE TWO `-because` KEYS AND THE FAULT LIST ARE WITHHELD FROM THE PROMPT and
# are not read here. They are coaching, and coaching available before the
# attempt is a spoiler. drill/study/CLAUDE.md says which half goes where.
#
# IT PARSES RATHER THAN GREPS so a key appearing in prose cannot be mistaken
# for a field. A field is a `- key: value` bullet INSIDE the section, and any
# `##` heading ends the section.
# ---------------------------------------------------------------------------
RB_PRESENT=0
RB_RUNS=""
RB_FAULT=""
RB_STATES=""
RB_OBL=""
rubric_read() {
  RB_PRESENT=0
  RB_RUNS=""
  RB_FAULT=""
  RB_STATES=""
  RB_OBL=""
  [ -f "$1" ] || return 0
  local line insec=0 key val
  while IFS= read -r line; do
    case "$line" in
    '##'*)
      case "$line" in
      '## Rubric' | '## Rubric '*) insec=1 RB_PRESENT=1 ;;
      *) insec=0 ;;
      esac
      continue
      ;;
    esac
    [ "$insec" = "1" ] || continue
    case "$line" in
    '- '*:*) : ;;
    *) continue ;;
    esac
    key="${line#- }"
    key="${key%%:*}"
    val="${line#*:}"
    while [ "${val# }" != "$val" ]; do val="${val# }"; done
    while [ "${val% }" != "$val" ]; do val="${val% }"; done
    case "$key" in
    runs) RB_RUNS="$val" ;;
    fault) RB_FAULT="$val" ;;
    states) RB_STATES="$val" ;;
    obligations) RB_OBL="$val" ;;
    esac
  done <"$1"
  return 0
}

# deadlocked <tlc output>: a reachable state with no successor. Measured
# `Error: Deadlock reached.` at rc 11. It is a violation with a trace and with
# no name to give, so it is the one shape that leaves invariant= at the marker
# on a violated run.
deadlocked() {
  grep -qE '^Error: Deadlock reached' <<<"$1"
}

# tlc_errored <tlc output>: TLC opened a line with `Error: `. Asked only after
# the two refutation questions above, so the trace header `Error: The behavior
# up to this point is:` never decides anything on its own.
tlc_errored() {
  grep -qE '^Error:' <<<"$1"
}

# violating_state <tlc output>: the LAST state of TLC's trace.
#
# A block opens with `State <n>: <where>` at column 0 and runs until a line
# that is not part of a value. Stopping at a blank line alone is not enough:
# a liveness counterexample ends `State 4: Stuttering` with no body at all and
# TLC's next chatter line immediately under it, which a blank-line reader
# swallows into the state. So a body line is recognized rather than a
# terminator -- a `/\` conjunct, an indented continuation of a value that
# wrapped, or `name = value` -- and anything else ends the block.
violating_state() {
  local line block="" collecting=0 nl=$'\n'
  while IFS= read -r line; do
    case "$line" in
    'State '[0-9]*':'*)
      block="$line"
      collecting=1
      continue
      ;;
    esac
    [ "$collecting" = 1 ] || continue
    case "$line" in
    '') collecting=0 ;;
    '/'* | ' '* | *' = '*) block="${block}${nl}${line}" ;;
    *) collecting=0 ;;
    esac
  done <<<"$1"
  printf '%s' "$block"
}

# ---------------------------------------------------------------------------
# Resolve what to check.
# ---------------------------------------------------------------------------

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
esac

if [ "$#" -gt 1 ]; then
  echo "check: one argument at most, got $#." >&2
  usage >&2
  exit 3
fi

TARGET="${1:-}"
if [ -z "$TARGET" ]; then
  WORK="$PWD"
  SLUG="$(basename -- "$PWD")"
elif [ -d "$TARGET" ]; then
  WORK="$(cd -- "$TARGET" && pwd)"
  SLUG="$(basename -- "$WORK")"
elif [ "${TARGET#*/}" != "$TARGET" ]; then
  # It carries a slash, so it was meant as a path and the path is not there.
  WORK="$TARGET"
  SLUG="$(basename -- "$TARGET")"
else
  WORK="${STUDY_ROOT}/${TARGET}"
  SLUG="$TARGET"
fi

# ---------------------------------------------------------------------------
# Resolve the prompt. Two hits is a corpus bug and gets reported as one.
# ---------------------------------------------------------------------------

HITS=()
for candidate in "$PROMPT_ROOT"/*/"$SLUG"/PROMPT.md; do
  [ -f "$candidate" ] && HITS+=("$candidate")
done

if [ "${#HITS[@]}" -eq 0 ]; then
  echo "check: no prompt for '${SLUG}'. Looked for ${PROMPT_ROOT}/*/${SLUG}/PROMPT.md." >&2
  exit 3
fi
if [ "${#HITS[@]}" -gt 1 ]; then
  echo "check: '${SLUG}' matches ${#HITS[@]} prompts. That is a corpus bug, not a choice to make:" >&2
  for candidate in "${HITS[@]}"; do
    echo "  ${candidate}" >&2
  done
  exit 3
fi
PROMPT="${HITS[0]}"

# ---------------------------------------------------------------------------
# The claim. No claim is still exit 2, but it NO LONGER SHORT-CIRCUITS the
# run, which is the whole of bead tla-rzvk.1. It used to return here, before
# asking for a model or for tlc, and that cost a session every objective fact
# about the run on 21 of the 64 prompts. The claim becomes the absent marker,
# the count verdict becomes NONE, and the exit is decided at the bottom.
#
# A consequence worth stating, because it moved an exit code: a no-claim
# prompt with no tlc on the path is now 3 rather than 2. The run is the
# deliverable on these prompts, so being unable to run it is "could not run".
# Exit 2 keeps its meaning. What changed is that it's no longer reached by
# declining to look.
# ---------------------------------------------------------------------------

CLAIMS="$(dedupe_csv "$(prose_claims "$PROMPT")$(table_claims "$PROMPT")")"

NOCLAIM=""
if [ -z "$CLAIMS" ]; then
  NOCLAIM=1
  CLAIMS="-"
fi

# ---------------------------------------------------------------------------
# The rubric. Prompt first, then the item's META.md under $DRILL_REPO_ROOT.
#
# RESOLVED HERE AND PRINTED LATER, next to the module lines it applies to. A
# declaration at the top of the output with the runs between it and the
# verdicts would make a reader scroll to find what the comparison was against.
#
# THE META.md ROUTE IS THE SAME GLOB THE PROMPT USED, so a slug matching two
# items is as much a corpus bug here as it is there. The difference is that
# this one does not refuse: the rubric is a report and the prompt is the
# instrument's subject, so a second hit stops the search rather than the run.
# ---------------------------------------------------------------------------
RUBRIC_SRC="none"
rubric_read "$PROMPT"
if [ "$RB_PRESENT" = "1" ]; then
  RUBRIC_SRC="prompt"
elif [ -n "$REPO_ROOT" ]; then
  for candidate in "$REPO_ROOT"/drill/*/"$SLUG"/META.md; do
    [ -f "$candidate" ] || continue
    rubric_read "$candidate"
    if [ "$RB_PRESENT" = "1" ]; then
      RUBRIC_SRC="meta"
      break
    fi
  done
fi

RB_LO=""
RB_HI=""
if [ -n "$RB_STATES" ]; then
  case "$RB_STATES" in
  *..*)
    RB_LO="${RB_STATES%%..*}"
    RB_HI="${RB_STATES##*..}"
    case "${RB_LO}${RB_HI}" in
    '' | *[!0-9]*)
      RB_LO=""
      RB_HI=""
      ;;
    esac
    ;;
  esac
fi

# ---------------------------------------------------------------------------
# The models, then the toolchain.
# ---------------------------------------------------------------------------

if [ ! -d "$WORK" ]; then
  echo "check: ${WORK} is not a directory, so there is no model to run." >&2
  exit 3
fi

# The configs this directory offers a module that has none of its own. Trace
# leavings are left out for the reason in the header: TLC writes a *_TTrace_*
# module with no config, so the leaving is an unpaired module and its own
# config, when an older build wrote one, is a leaving too.
CONFIGS=()
for candidate in "$WORK"/*.cfg; do
  [ -f "$candidate" ] || continue
  cbase="${candidate##*/}"
  case "$cbase" in
  *_TTrace_*) continue ;;
  esac
  CONFIGS+=("$cbase")
done

CANDIDATES=""
for cbase in ${CONFIGS[@]+"${CONFIGS[@]}"}; do
  CANDIDATES="${CANDIDATES:+${CANDIDATES}, }${cbase}"
done

# MODULES and USING run in step: USING[i] is the config MODULES[i] runs with.
# UNRUN and WHY run in step the same way.
MODULES=()
USING=()
UNRUN=()
WHY=()
for candidate in "$WORK"/*.tla; do
  [ -f "$candidate" ] || continue
  base="${candidate##*/}"
  base="${base%.tla}"
  case "$base" in
  *_TTrace_*) continue ;;
  esac

  if [ -f "${WORK}/${base}.cfg" ]; then
    MODULES+=("$base")
    USING+=("${base}.cfg")
    continue
  fi

  if [ "${#CONFIGS[@]}" -eq 0 ]; then
    UNRUN+=("$base")
    WHY+=("no ${base}.cfg, and no other config in the directory")
    continue
  fi
  if [ "${#CONFIGS[@]}" -gt 1 ]; then
    UNRUN+=("$base")
    WHY+=("no ${base}.cfg, and ${#CONFIGS[@]} configs to choose from: ${CANDIDATES}")
    continue
  fi

  only="${CONFIGS[0]}"
  NAMES=()
  while IFS= read -r one; do
    [ -n "$one" ] && NAMES+=("$one")
  done < <(config_runs "${WORK}/${only}")

  if [ "${#NAMES[@]}" -eq 0 ]; then
    UNRUN+=("$base")
    WHY+=("${only} names no SPECIFICATION and no INIT/NEXT pair")
    continue
  fi

  if defines_all "$candidate" ${NAMES[@]+"${NAMES[@]}"}; then
    MODULES+=("$base")
    USING+=("$only")
    continue
  fi

  joined="${NAMES[0]}"
  [ "${#NAMES[@]}" -gt 1 ] && joined="${NAMES[0]} and ${NAMES[1]}"
  UNRUN+=("$base")
  WHY+=("does not define ${joined}, which ${only} names")
done

# The unrun report comes before the toolchain check and before the exit for a
# directory with nothing to run, because it is true whichever way those two
# go. A directory whose only module is one this script will not run is where
# the name matters most, and putting the report behind either gate would leave
# that case silent again.
u=0
while [ "$u" -lt "${#UNRUN[@]}" ]; do
  printf 'module=%s NOT RUN: %s\n' "${UNRUN[$u]}" "${WHY[$u]}"
  u=$((u + 1))
done

if [ "${#MODULES[@]}" -eq 0 ]; then
  echo "check: no module under ${WORK} that a config there can run." >&2
  exit 3
fi

if ! command -v tlc >/dev/null 2>&1; then
  echo "check: tlc is not on the path, so nothing was checked." >&2
  exit 3
fi

# ---------------------------------------------------------------------------
# The scratch copy TLC runs in. See the header: TLC writes in whatever
# directory it runs in, and the directory it would otherwise run in holds the
# only copy of Frank's work.
#
# A scratch directory this script cannot make is exit 3 rather than a run in
# the work directory. Falling back would put the defect back silently, on the
# one tree that has no copy, and "could not run" is both true and safe.
# ---------------------------------------------------------------------------

SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/drill-check.XXXXXXXX" 2>/dev/null)"
if [ -z "$SCRATCH" ] || [ ! -d "$SCRATCH" ]; then
  echo "check: could not make a scratch directory to run TLC in, so nothing was checked." >&2
  exit 3
fi
# shellcheck disable=SC2317  # reached through the EXIT trap on the next line
drop_scratch() { rm -rf "$SCRATCH"; }
trap drop_scratch EXIT

# EVERY MODULE GOES ACROSS, not only the ones about to be run. A module another
# one EXTENDS has to sit beside it or TLC reports `Cannot find source file for
# module Lib` and the run fails at the parse. That turns a right model into
# run=ERROR, which is the false-fail direction on a drill loop. Configs go
# across for the same reason, since a borrowed one is named on the TLC line.
#
# Top level only, which is all the glob reaches anyway. Nothing under states/
# is a module Frank wrote.
for candidate in "$WORK"/*.tla "$WORK"/*.cfg; do
  [ -f "$candidate" ] || continue
  if ! cp -- "$candidate" "${SCRATCH}/"; then
    echo "check: could not copy ${candidate} into ${SCRATCH}, so nothing was checked." >&2
    exit 3
  fi
done

# ---------------------------------------------------------------------------
# Run each model and report it.
# ---------------------------------------------------------------------------

# The declaration, read back, so a reader can see what the three rubric
# verdicts below were compared against. `rubric=none` is the common case.
if [ "$RUBRIC_SRC" = "none" ]; then
  printf 'rubric=none\n'
else
  printf 'rubric=%s runs=%s fault=%s states=%s obligations=%s\n' \
    "$RUBRIC_SRC" "${RB_RUNS:--}" "${RB_FAULT:--}" "${RB_STATES:--}" "${RB_OBL:--}"
fi

MISSED=()
mi=0
for module in "${MODULES[@]}"; do
  cfg="${USING[$mi]}"
  mi=$((mi + 1))
  out="$(cd -- "$SCRATCH" && tlc -config "$cfg" "$module" 2>&1)"
  rc=$?

  # The count dimension.
  count="$(last_count "$out")"
  shown="${count:--}"
  if [ -n "$NOCLAIM" ]; then
    verdict="NONE"
  elif [ -z "$count" ]; then
    verdict="MISMATCH"
  elif claim_matches "$count" "$CLAIMS"; then
    verdict="MATCH"
  else
    verdict="MISMATCH"
  fi

  # The run dimension. The order is the precedence: a refutation this script
  # can name, then one it cannot, then any other error, then the two ways a
  # run with no error ends. Nothing here reads rc, which does not predict
  # either answer.
  name="$(violated_name "$out")"
  if [ -n "$name" ]; then
    run="VIOLATED"
  elif deadlocked "$out"; then
    run="VIOLATED"
    name="-"
  elif tlc_errored "$out"; then
    run="ERROR"
    name="-"
  elif [ -n "$count" ]; then
    run="CLEAN"
    name="-"
  else
    run="NOCOUNT"
    name="-"
  fi

  # The three rubric dimensions. Each one reads the run dimension above rather
  # than the rc, for the reason the header gives: the rc does not predict
  # either answer, and `run=` is already the reading of the log that does.
  #
  # NONE OF THEM MOVES THE EXIT CODE. See the rubric section of the header.
  rb_runs="-"
  if [ -n "$RB_RUNS" ]; then
    case "$run" in
    CLEAN | VIOLATED) got_runs="yes" ;;
    *) got_runs="no" ;;
    esac
    if [ "$got_runs" = "$RB_RUNS" ]; then rb_runs="MET"; else rb_runs="UNMET"; fi
  fi

  rb_fault="-"
  if [ -n "$RB_FAULT" ]; then
    case "$run" in
    CLEAN) got_fault="none" ;;
    VIOLATED)
      got_fault="$(violated_kind "$out")"
      # A deadlock is the one violation with no name and no keyword, so it is
      # what is left when the three phrasings do not match.
      [ -n "$got_fault" ] || got_fault="deadlock"
      ;;
    *) got_fault="" ;;
    esac
    if [ -z "$got_fault" ]; then
      rb_fault="UNKNOWN"
    elif [ "$got_fault" = "$RB_FAULT" ]; then
      rb_fault="MET"
    else
      rb_fault="UNMET"
    fi
  fi

  rb_states="-"
  if [ -n "$RB_LO" ] && [ -n "$count" ]; then
    if [ "$count" -ge "$RB_LO" ] && [ "$count" -le "$RB_HI" ]; then
      rb_states="IN"
    else
      rb_states="OUT"
    fi
  fi

  printf 'module=%s config=%s rc=%s distinct=%s claimed=%s count=%s run=%s invariant=%s rubric-runs=%s rubric-fault=%s rubric-states=%s\n' \
    "$module" "$cfg" "$rc" "$shown" "$CLAIMS" "$verdict" "$run" "$name" \
    "$rb_runs" "$rb_fault" "$rb_states"

  if [ "$run" = "VIOLATED" ]; then
    state="$(violating_state "$out")"
    if [ -n "$state" ]; then
      while IFS= read -r stateline; do
        printf '  %s\n' "$stateline"
      done <<<"$state"
    fi
  fi

  [ "$verdict" = "MISMATCH" ] && MISSED+=("$module")
done

if [ -n "$NOCLAIM" ]; then
  printf 'UNCHECKED: %s publishes no distinct-state count, so nothing was compared. The run verdict on each line above still came from TLC.\n' "$SLUG"
  exit 2
fi

if [ "${#MISSED[@]}" -eq 0 ]; then
  printf 'MATCHED: %s of %s module(s) reached a count %s publishes.\n' \
    "${#MODULES[@]}" "${#MODULES[@]}" "$SLUG"
  exit 0
fi

printf 'MISMATCHED: %s of %s module(s) did not reach a count %s publishes: %s\n' \
  "${#MISSED[@]}" "${#MODULES[@]}" "$SLUG" "${MISSED[*]}"
exit 1
