# Budget-drift nudge. See "WHY A WARNING AND NOT A FAILURE" in the header
# before changing either number, and do not wire them to the exit code.
BUDGET_DRIFT_FACTOR=3        # elapsed must be at least this many times budget
BUDGET_DRIFT_FLOOR_MS=5000   # ...AND at least this far over it in absolute ms

# --- millisecond wall clock -------------------------------------------------
# The budgets go down to 0.7 s, so the integer-second $SECONDS this script used
# before cannot compare against them at all. EPOCHREALTIME is a bash-5 builtin
# and costs no fork; strip every non-digit rather than just '.', because bash
# formats it with the locale's decimal separator, which is ',' in some locales.
# On bash 4 it is unset and we degrade to exactly the old integer seconds —
# still right for the multi-second suites, and the 5 s floor means the
# sub-second rows simply never trip the check.
NOW_MS=0
now_ms() {
  if [ -n "${EPOCHREALTIME:-}" ]; then
    local t=${EPOCHREALTIME//[^0-9]/}
    NOW_MS=$(( t / 1000 ))
  else
    NOW_MS=$(( SECONDS * 1000 ))
  fi
}

# "11.7" -> 11700. Bare integers ("12") are accepted as 12000.
BUDGET_MS=0
budget_to_ms() {
  local whole=${1%%.*} frac
  if [ "$1" = "$whole" ]; then
    frac=000
  else
    frac="${1#*.}00"
    frac=${frac:0:3}
  fi
  BUDGET_MS=$(( 10#$whole * 1000 + 10#$frac ))
}

# 11732 -> "11.7"
fmt_secs() {
  printf -v FMT_SECS '%d.%d' $(( $1 / 1000 )) $(( ($1 % 1000) / 100 ))
}

MODE="full"
VERBOSE=0
FILTER=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --fast)      MODE="fast" ;;
    --full)      MODE="full" ;;
    -v|--verbose) VERBOSE=1 ;;
    --list)      MODE="list" ;;
    -h|--help)
      # Print the whole header block, stopping at the first line of code. This
      # used to be `sed -n '2,55p'`, a line number that silently truncated the
      # help text the moment the header grew — which is the same shape of drift
      # as the stale tier table this script now warns about.
      awk 'NR > 1 && /^set -euo pipefail$/ { exit } NR > 1' "${BASH_SOURCE[0]}"
      exit 0
      ;;
    -*)
      echo "scripts/test: unknown option '$1' (try --help)" >&2
      exit 2
      ;;
    *)           FILTER="$1" ;;
  esac
  shift
done

if [ "$MODE" = "list" ]; then
  printf '%-6s %8s  %s\n' TIER BUDGET SUITE
  for entry in "${SUITES[@]}"; do
    IFS='|' read -r tier budget label cmd <<<"$entry"
    printf '%-6s %7ss  %s\n            %s\n' "$tier" "$budget" "$label" "$cmd"
  done
  exit 0
fi

LOGDIR="$(mktemp -d)"
# shellcheck disable=SC2317  # reached through the EXIT trap on the next line
cleanup() { rm -rf "$LOGDIR"; }
trap cleanup EXIT

echo "scripts/test: mode=${MODE}${FILTER:+ filter=$FILTER} root=${REPO_ROOT}"
echo

selected=0
failed=0
declare -a FAILED_LABELS=()
declare -a DRIFT_LINES=()
now_ms; total_start=${NOW_MS}

for entry in "${SUITES[@]}"; do
  IFS='|' read -r tier budget label cmd <<<"$entry"

  if [ "$MODE" = "fast" ] && [ "$tier" != "fast" ]; then
    continue
  fi
  if [ -n "$FILTER" ] && [[ "$label $cmd" != *"$FILTER"* ]]; then
    continue
  fi

  selected=$((selected + 1))
  log="${LOGDIR}/$(printf '%02d' "$selected").log"
  now_ms; start=${NOW_MS}

  # No pipe: the output goes straight to a file. Piping a chatty suite into
  # anything that can close early is the SIGPIPE-141 trap this repo already
  # paid for once (bead tla-kr9) — see .claude/rules/dispatched-agents.md.
  set +e
  if [ "$VERBOSE" = "1" ]; then
    printf '=== %s (%s, budget %ss)\n' "$label" "$tier" "$budget"
    bash -c "$cmd" 2>&1 | tee "$log"
    rc=${PIPESTATUS[0]}
  else
    bash -c "$cmd" >"$log" 2>&1
    rc=$?
  fi
  set -e

  now_ms; elapsed=$((NOW_MS - start))
  fmt_secs "$elapsed"; elapsed_s=${FMT_SECS}

  if [ "$rc" -eq 0 ]; then
    # Budget drift. Checked only on a pass: a failing suite's wall clock says
    # nothing useful, and the FAIL is the message that matters there.
    budget_to_ms "$budget"
    drift=""
    if [ "$BUDGET_MS" -gt 0 ] \
       && [ "$elapsed" -ge $((BUDGET_MS * BUDGET_DRIFT_FACTOR)) ] \
       && [ $((elapsed - BUDGET_MS)) -ge "$BUDGET_DRIFT_FLOOR_MS" ]; then
      ratio=$(( elapsed * 10 / BUDGET_MS ))
      drift="$(printf '%d.%dx' $((ratio / 10)) $((ratio % 10)))"
      DRIFT_LINES+=("$(printf '%-34s %6ss  vs budget %ss  (%s)' \
        "$label" "$elapsed_s" "$budget" "$drift")")
    fi
    if [ -n "$drift" ]; then
      printf '  PASS  %-34s %6ss  (budget %ss)  <<< %s OVER BUDGET\n' \
        "$label" "$elapsed_s" "$budget" "$drift"
    else
      printf '  PASS  %-34s %6ss  (budget %ss)\n' "$label" "$elapsed_s" "$budget"
    fi
  else
    printf '  FAIL  %-34s %6ss  rc=%s\n' "$label" "$elapsed_s" "$rc"
    failed=$((failed + 1))
    FAILED_LABELS+=("$label")
    if [ "$VERBOSE" != "1" ]; then
      echo "        command: $cmd"
      echo "        ---- output ----"
      sed 's/^/        /' "$log"
      echo "        ---- end output ----"
    fi
  fi
done

now_ms; total_elapsed=$((NOW_MS - total_start))
fmt_secs "$total_elapsed"; total_elapsed_s=${FMT_SECS}

echo
if [ "$selected" -eq 0 ]; then
  echo "scripts/test: no suite matched${FILTER:+ filter=$FILTER} — refusing to report success." >&2
  echo "  Run 'bash scripts/test --list' to see the suite table." >&2
  exit 2
fi

# The budget-drift nudge. Deliberately NOT wired to the exit code — see
# "WHY A WARNING AND NOT A FAILURE" in this script's header before changing it.
if [ "${#DRIFT_LINES[@]}" -gt 0 ]; then
  echo "BUDGET DRIFT: ${#DRIFT_LINES[@]} suite(s) ran far over the wall clock recorded for them."
  for d in "${DRIFT_LINES[@]}"; do
    echo "  - $d"
  done
  echo
  echo "  Those budgets are the evidence for the fast/slow tier split in scripts/test."
  echo "  A suite this far over has probably outgrown its tier — which is exactly how"
  echo "  --fast quietly stopped being fast once before (bead tla-htx)."
  echo "  If the box was loaded, ignore this. If it was not, re-measure and update BOTH"
  echo "  the budget and the tier in the SUITES table."
  echo
fi

if [ "$failed" -eq 0 ]; then
  echo "OK: ${selected} suite(s) passed in ${total_elapsed_s}s"
  exit 0
fi

echo "FAILED: ${failed} of ${selected} suite(s) in ${total_elapsed_s}s"
for l in "${FAILED_LABELS[@]}"; do
  echo "  - $l"
done
exit 1
