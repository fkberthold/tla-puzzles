#!/usr/bin/env bash
# scripts/cibuild — the full CI pass: everything scripts/test runs, plus the
# checks that only make sense with a full checkout and a pinned toolchain.
#
# Usage:
#   bash scripts/cibuild                 # all five phases
#   bash scripts/cibuild --skip-corpus   # skip the puzzles/ sweep (the slow one)
#   bash scripts/cibuild --skip-docs     # skip the mkdocs build
#   bash scripts/cibuild --list          # print the phase list and exit
#
# Fail-fast: the first failing phase ends the run. That is deliberate — phase 5
# model-checks the whole v1 puzzle corpus and is by far the most expensive
# thing here, so there is no reason to spend CI minutes on it after an earlier
# phase has already decided the answer.
#
# ---------------------------------------------------------------------------
# PHASES
#
#   1. toolchain pin      every recorded copy of the pin agrees — version
#                         string AND release tag, across this script,
#                         scripts/setup, verify-puzzles.yml and README.md —
#                         build-docs.sh derives rather than copies it, and
#                         the installed tlc actually reports it
#   2. scripts/lint       shellcheck over scripts/ + harness/
#   3. scripts/test       all ten suites — 292 harness assertions, ~121 s
#   4. docs build         scripts/build-docs.sh + mkdocs build
#   5. puzzle corpus      scripts/verify-puzzle.sh over every puzzles/*/ that
#                         ships a solution/
#
# WIRED INTO CI ON 2026-08-07 (bead tla-1qn).
# .github/workflows/verify-puzzles.yml calls `bash scripts/cibuild` with no
# --skip flags, on every pull request and every push to main, with no paths:
# filter. A change here now changes what CI does. The workflow installs the
# toolchain, asserts the pin, then hands over. Keep its TLA_RELEASE and
# EXPECT_TLC lines exactly one line each: phase 1 reads them back out of it.
#
# pages.yml stays deploy-only. It builds the same docs as phase 4, and putting
# the corpus in front of a docs deploy would buy nothing.
# ---------------------------------------------------------------------------

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}" || exit 1

# Fail closed on a mis-resolved root; every path below is relative.
if [ ! -d "${REPO_ROOT}/harness" ] || [ ! -d "${REPO_ROOT}/scripts" ]; then
  echo "scripts/cibuild: ${REPO_ROOT} is not the tla-puzzles root (no harness/ + scripts/)." >&2
  exit 2
fi

# Kept in step with scripts/setup, .github/workflows/verify-puzzles.yml and
# README.md by phase 1 below, which compares them rather than trusting them to
# match. scripts/build-docs.sh is deliberately NOT on that list: it reads the
# tag out of scripts/setup, so it has no copy to compare (bead tla-urv).
EXPECT_TLC="2026.07.31"
TLA_RELEASE="tla2tools-v1.8.0-20260731"
# The digest is the half of the pin a tag cannot cover (bead tla-yvky): the
# tag above is a release this repo controls, but the sha256 is what
# scripts/setup actually checks the download against.
EXPECT_SHA256="e22f8ffb4bacdea0a871f444dd94fe5fb0d8013b3388ae39e82e26f852c735d5"

DO_CORPUS=1
DO_DOCS=1
while [ "$#" -gt 0 ]; do
  case "$1" in
    --skip-corpus) DO_CORPUS=0 ;;
    --skip-docs)   DO_DOCS=0 ;;
    --list)        sed -n '19,38p' "${BASH_SOURCE[0]}"; exit 0 ;;
    -h|--help)     sed -n '2,10p' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "scripts/cibuild: unknown option '$1' (try --help)" >&2; exit 2 ;;
  esac
  shift
done

phase() { printf '\n=== cibuild phase %s: %s\n' "$1" "$2"; }

# --- phase 1: the pin ------------------------------------------------------
phase 1 "toolchain pin (${TLA_RELEASE} / TLC2 ${EXPECT_TLC})"

pin_in_setup="$(sed -n 's/^EXPECT_TLC="\(.*\)"$/\1/p' scripts/setup)"
pin_in_ci="$(sed -n "s/^ *EXPECT_TLC: *'\(.*\)'\$/\1/p" .github/workflows/verify-puzzles.yml)"

if [ "$pin_in_setup" != "$EXPECT_TLC" ]; then
  echo "cibuild: pin drift — scripts/setup says '${pin_in_setup}', this script says '${EXPECT_TLC}'" >&2
  exit 1
fi
if [ "$pin_in_ci" != "$EXPECT_TLC" ]; then
  echo "cibuild: pin drift — verify-puzzles.yml says '${pin_in_ci}', this script says '${EXPECT_TLC}'" >&2
  exit 1
fi
echo "  ok    all three recorded copies of the version string agree"

# --- the RELEASE TAG, checked the same way ---------------------------------
# Until bead tla-urv, TLA_RELEASE above was declared here and compared against
# nothing — only EXPECT_TLC was cross-checked. The tag is the half that picks
# which jar gets downloaded, so an unchecked copy of it is the more dangerous
# one: scripts/build-docs.sh carried `releases/latest/download/` for months,
# which resolves to v1.7.4 (published 2024-08-05) because GitHub's `latest`
# skips prereleases and v1.8.0 is flagged as one. Learners were being told to
# install a 2024 toolchain (bead tla-urv; same trap as tla-5b4 in CI).

rel_in_setup="$(sed -n 's/^TLA_RELEASE="\(.*\)"$/\1/p' scripts/setup)"
rel_in_ci="$(sed -n "s/^ *TLA_RELEASE: *\(.*\)\$/\1/p" .github/workflows/verify-puzzles.yml)"

if [ "$rel_in_setup" != "$TLA_RELEASE" ]; then
  echo "cibuild: release drift — scripts/setup says '${rel_in_setup}', this script says '${TLA_RELEASE}'" >&2
  exit 1
fi
if [ "$rel_in_ci" != "$TLA_RELEASE" ]; then
  echo "cibuild: release drift — verify-puzzles.yml says '${rel_in_ci}', this script says '${TLA_RELEASE}'" >&2
  exit 1
fi

# README.md is copied verbatim to docs/index.md by scripts/build-docs.sh, so
# its install line is learner-facing and has to name the same asset.
PINNED_JAR_URL="https://github.com/fkberthold/tla-puzzles/releases/download/${TLA_RELEASE}/tla2tools.jar"
if ! grep -qF "$PINNED_JAR_URL" README.md; then
  echo "cibuild: README.md does not name the pinned jar — expected ${PINNED_JAR_URL}" >&2
  exit 1
fi
echo "  ok    all three recorded copies of the release tag agree, and README names it"

# --- the DIGEST, checked the same way ---------------------------------------
# A tag names one artifact only as long as nobody rebinds it. v1.8.0 got
# rebound three times in 22 days once GitHub flagged it prerelease, and CI ran
# 15 days red against a version the tag had stopped serving (bead tla-yvky).
# The sha256 is what actually pins the download, so it gets the same
# cross-check the tag and the version string get above.
sha_in_setup="$(sed -n 's/^TLA_JAR_SHA256_PIN="\(.*\)"$/\1/p' scripts/setup)"
sha_in_ci="$(sed -n "s/^ *EXPECT_SHA256: *'\(.*\)'\$/\1/p" .github/workflows/verify-puzzles.yml)"

if [ "$sha_in_setup" != "$EXPECT_SHA256" ]; then
  echo "cibuild: digest drift — scripts/setup says '${sha_in_setup}', this script says '${EXPECT_SHA256}'" >&2
  exit 1
fi
if [ "$sha_in_ci" != "$EXPECT_SHA256" ]; then
  echo "cibuild: digest drift — verify-puzzles.yml says '${sha_in_ci}', this script says '${EXPECT_SHA256}'" >&2
  exit 1
fi
echo "  ok    all three recorded copies of the sha256 digest agree"

# --- the docs generator must DERIVE the pin, never carry a copy -------------
# scripts/build-docs.sh reads TLA_RELEASE out of scripts/setup. These two
# checks keep it that way: no `latest`, and no hardcoded tlaplus release tag
# that could drift from the one above.
# The pattern includes the ASSET FILENAME on purpose. Both files below name
# the bare fragment `releases/latest/download/` in a warning against using it,
# and build-docs.sh carries its own guard against it — a looser pattern fires
# on that documentation instead of on the mistake. Only a line that actually
# fetches the asset needs to spell the filename out.
for f in scripts/build-docs.sh README.md; do
  if grep -qF 'releases/latest/download/tla2tools.jar' "$f"; then
    echo "cibuild: ${f} fetches releases/latest/download/tla2tools.jar — that resolves" >&2
    echo "  to v1.7.4 (2024-08-05); GitHub's \`latest\` skips prereleases (tla-5b4, tla-urv)." >&2
    exit 1
  fi
done
if grep -qF 'tla-puzzles/releases/download/tla2tools-v' scripts/build-docs.sh; then
  echo "cibuild: scripts/build-docs.sh hardcodes a release tag. It must read" >&2
  echo "  TLA_RELEASE from scripts/setup instead, so there is no copy to drift (tla-urv)." >&2
  exit 1
fi
echo "  ok    build-docs.sh derives the pin rather than copying it"

if ! command -v tlc >/dev/null 2>&1; then
  echo "cibuild: tlc not on PATH. Run: bash scripts/setup" >&2
  exit 1
fi
# Here-string, never a live pipe: `tlc | grep -q` returns 141 under pipefail
# and would report a matching version as a mismatch (bead tla-kr9).
tlc_out="$(tlc 2>&1 || true)"
if ! grep -qF "TLC2 Version ${EXPECT_TLC}" <<<"$tlc_out"; then
  echo "cibuild: the installed TLC does not report the pin." >&2
  echo "  expected: TLC2 Version ${EXPECT_TLC}" >&2
  echo "  got:      $(sed -n '1p' <<<"$tlc_out")" >&2
  echo "  Fix with: bash scripts/setup   (see bead tla-wl7)" >&2
  exit 1
fi
echo "  ok    installed tlc reports TLC2 Version ${EXPECT_TLC}"

# --- phase 2: lint ---------------------------------------------------------
phase 2 "scripts/lint"
bash scripts/lint

# --- phase 3: tests --------------------------------------------------------
phase 3 "scripts/test (all suites)"
bash scripts/test

# --- phase 4: docs ---------------------------------------------------------
if [ "$DO_DOCS" = "1" ]; then
  phase 4 "docs build"
  bash scripts/build-docs.sh
  if ! command -v mkdocs >/dev/null 2>&1; then
    echo "cibuild: mkdocs is not installed. Run: bash scripts/setup" >&2
    exit 1
  fi
  mkdocs build
else
  phase 4 "docs build — SKIPPED (--skip-docs)"
fi

# --- phase 5: the puzzle corpus -------------------------------------------
if [ "$DO_CORPUS" = "1" ]; then
  phase 5 "puzzle corpus (scripts/verify-puzzle.sh over puzzles/*/)"
  fail_count=0
  pass_count=0
  fail_list=""
  for dir in puzzles/*/; do
    puzzle="${dir%/}"
    [ -d "$puzzle/solution" ] || continue
    set +e
    output="$(scripts/verify-puzzle.sh "$puzzle" 2>&1)"
    rc=$?
    set -e
    echo "$output"
    if [ "$rc" -ne 0 ]; then
      fail_count=$((fail_count + 1))
      fail_list="$fail_list $puzzle"
    else
      pass_count=$((pass_count + 1))
    fi
  done
  echo
  echo "  corpus: ${pass_count} passed, ${fail_count} failed"
  if [ "$fail_count" -ne 0 ]; then
    echo "  failed puzzles:$fail_list" >&2
    exit 1
  fi
else
  phase 5 "puzzle corpus — SKIPPED (--skip-corpus)"
fi

echo
echo "OK: cibuild passed"
