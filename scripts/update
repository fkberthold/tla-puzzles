#!/usr/bin/env bash
# scripts/update — bring an existing checkout back in step after a pull.
#
# Usage:
#   bash scripts/update            # re-assert the toolchain pin + docs deps
#   bash scripts/update --check    # report what would change; touch nothing
#
# ---------------------------------------------------------------------------
# WHY THIS DELEGATES TO scripts/setup RATHER THAN BEING MARKED N/A
#
# The convention's `update` is "setup for a checkout that already exists".
# Here that is not a no-op, and it is not busywork either: scripts/setup
# carries the TLC version pin, so when the pin moves in a commit you just
# pulled, this is the script that moves your local toolchain with it. A
# checkout whose jar is a version behind the pin produces verdicts that
# disagree with CI's, and nothing announces it — which is the whole reason
# the pin is asserted rather than logged (bead tla-5b4).
#
# scripts/setup is idempotent and skips the download when the installed jar
# already reports the pinned version, so re-running this after every pull
# costs about a second when nothing has changed.
#
# It is NOT marked N/A precisely because of that pin. If this project ever
# drops to an unpinned toolchain, revisit.
# ---------------------------------------------------------------------------

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

echo "scripts/update: delegating to scripts/setup (idempotent; re-asserts the TLC pin)"
exec bash "${SCRIPT_DIR}/setup" "$@"
