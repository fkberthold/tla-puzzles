#!/usr/bin/env bash
# scripts/lint — run static analysis over this project's shell.
#
# The project's primary runtime is bash (see .claude/project-constitution.md),
# so shellcheck IS the linter. Files are selected BY SHEBANG rather than by
# extension, and the trees are scanned rather than enumerated, so a shell file
# that lands tomorrow is covered the moment it appears. That selection strategy
# is lifted from harness/test-pipefail.sh, which gates the SIGPIPE idiom the
# same way and for the same reason: an enumerated list silently stops covering
# the tree the first time someone adds a file.
#
# Usage:
#   bash scripts/lint                # check every shell file under the roots
#   bash scripts/lint --list         # print the files that would be checked
#   bash scripts/lint <path> [...]   # check only the named paths
#
# Runs shellcheck at its DEFAULT severity — style and info included. It is
# wired as a real gate: it exits non-zero on any finding, so CI and hooks can
# depend on it.
#
# ---------------------------------------------------------------------------
# STATUS AS OF 2026-08-07 (bead tla-5r7): THIS GATE IS GREEN.
#
# tla-xme wired the runner and left its 26 findings standing, because wiring a
# runner is not the same job as editing what the runner runs. tla-5r7 cleared
# them: 3 SC1087, 8 warnings, 14 infos, 1 style, over 15 files.
#
# Most were real and got a real fix. Six bare `cd "$REPO_ROOT"` calls gained
# `|| exit 1`, which matters because those suites run under `set -uo pipefail`
# with no `-e`, so a failed cd used to run the whole suite from the wrong
# directory. Two unused variables turned out to be dead rather than a dropped
# assertion, and went away. The `A && ok || fail` pair in the screen fixture
# selftest became if-then-else.
#
# The 3 SC1087 in refinement.sh got braces, `${reserved}` for `$reserved`.
# That is a no-op at runtime: bash does not index without braces, so the old
# form expanded the variable and left the bracket expression alone. It was
# checked against a running shell before being touched, not assumed, because
# the other reading would have meant three silently wrong matches.
#
# Seven sites carry a per-site `# shellcheck disable=`, each with a comment
# saying why the checker is wrong there. Five are SC2317 on cleanup() bodies
# reached through an EXIT trap, which shellcheck does not follow. Two are
# SC2016 on single-quoted literals that must not expand.
#
# Keep it green the same way. Do NOT lower severity, add blanket --exclude
# flags, or sweep disable comments across a file. Any of those converts a red
# gate into a green lie, which is the failure mode this script exists to avoid.
# A disable belongs at one site, with the reason next to it.
# ---------------------------------------------------------------------------
#
# Lint roots. chapter/ is NOT here: it holds one shell file
# (chapter/snippets/run-all.sh), it was clean on 2026-08-07, and adding it is
# a one-word change when someone wants the coverage.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}" || exit 1

# Fail closed on a mis-resolved root: an empty file set would otherwise be
# indistinguishable from a clean tree.
if [ ! -d "${REPO_ROOT}/harness" ] || [ ! -d "${REPO_ROOT}/scripts" ]; then
  echo "scripts/lint: ${REPO_ROOT} is not the tla-puzzles root (no harness/ + scripts/)." >&2
  exit 2
fi

LINT_ROOTS=(scripts harness)

LIST_ONLY=0
declare -a EXPLICIT=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --list) LIST_ONLY=1 ;;
    -h|--help)
      sed -n '2,22p' "${BASH_SOURCE[0]}"
      exit 0
      ;;
    *) EXPLICIT+=("$1") ;;
  esac
  shift
done

if ! command -v shellcheck >/dev/null 2>&1; then
  echo "scripts/lint: shellcheck is not installed." >&2
  echo "  Install it, then re-run: bash scripts/bootstrap" >&2
  exit 2
fi

declare -a FILES=()

if [ "${#EXPLICIT[@]}" -gt 0 ]; then
  FILES=("${EXPLICIT[@]}")
else
  # Shebang-selected. `read -r -d ''` over a NUL-delimited find keeps paths
  # with spaces intact and avoids a pipe into the loop (a pipe would also put
  # the loop in a subshell, so FILES would come back empty).
  while IFS= read -r -d '' f; do
    first=""
    IFS= read -r first <"$f" || true
    case "$first" in
      '#!'*sh*) FILES+=("$f") ;;
    esac
  done < <(find "${LINT_ROOTS[@]}" -type f -print0)
fi

if [ "${#FILES[@]}" -eq 0 ]; then
  echo "scripts/lint: no shell files found under: ${LINT_ROOTS[*]}" >&2
  echo "  Refusing to report success over an empty set." >&2
  exit 2
fi

if [ "$LIST_ONLY" = "1" ]; then
  printf '%s\n' "${FILES[@]}" | sort
  exit 0
fi

echo "scripts/lint: shellcheck ${#FILES[@]} shell file(s) under ${LINT_ROOTS[*]}"
echo

set +e
shellcheck "${FILES[@]}"
rc=$?
set -e

echo
if [ "$rc" -eq 0 ]; then
  echo "OK: shellcheck clean over ${#FILES[@]} file(s)"
else
  echo "FAILED: shellcheck reported findings (rc=${rc}) over ${#FILES[@]} file(s)" >&2
fi
exit "$rc"
