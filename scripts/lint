#!/usr/bin/env bash
# scripts/lint — run static analysis over this project's shell.
#
# The project's primary runtime is bash (see .claude/project-constitution.md),
# so shellcheck IS the linter. Files are selected BY SHEBANG rather than by
# extension, and the trees are scanned rather than enumerated, so a shell file
# that lands tomorrow is covered the moment it appears. That selection strategy
# is lifted from harness/test-pipefail.sh, which gates the SIGPIPE idiom the
# same way and for the same reason: an enumerated list silently stops covering
# the tree the first time someone adds a file.
#
# Usage:
#   bash scripts/lint                # check every shell file under the roots
#   bash scripts/lint --list         # print the files that would be checked
#   bash scripts/lint <path> [...]   # check only the named paths
#
# Runs shellcheck at its DEFAULT severity — style and info included. It is
# wired as a real gate: it exits non-zero on any finding, so CI and hooks can
# depend on it.
#
# ---------------------------------------------------------------------------
# STATUS AS OF 2026-08-07 (bead tla-5r7): THIS GATE IS GREEN.
#
# tla-xme wired the runner and left its 26 findings standing, because wiring a
# runner is not the same job as editing what the runner runs. tla-5r7 cleared
# them: 3 SC1087, 8 warnings, 14 infos, 1 style, over 15 files.
#
# Most were real and got a real fix. Six bare `cd "$REPO_ROOT"` calls gained
# `|| exit 1`, which matters because those suites run under `set -uo pipefail`
# with no `-e`, so a failed cd used to run the whole suite from the wrong
# directory. Two unused variables turned out to be dead rather than a dropped
# assertion, and went away. The `A && ok || fail` pair in the screen fixture
# selftest became if-then-else.
#
# The 3 SC1087 in refinement.sh got braces, `${reserved}` for `$reserved`.
# That is a no-op at runtime: bash does not index without braces, so the old
# form expanded the variable and left the bracket expression alone. It was
# checked against a running shell before being touched, not assumed, because
# the other reading would have meant three silently wrong matches.
#
# Seven sites carry a per-site `# shellcheck disable=`, each with a comment
# saying why the checker is wrong there. Five are SC2317 on cleanup() bodies
# reached through an EXIT trap, which shellcheck does not follow. Two are
# SC2016 on single-quoted literals that must not expand.
#
# Keep it green the same way. Do NOT lower severity, add blanket --exclude
# flags, or sweep disable comments across a file. Any of those converts a red
# gate into a green lie, which is the failure mode this script exists to avoid.
# A disable belongs at one site, with the reason next to it.
# ---------------------------------------------------------------------------
#
# The lint roots, and the per-root floors that keep them honest, are further
# down next to the lists themselves. This block used to carry a second,
# contradicting note here saying chapter/ was not a root, written on 2026-08-07
# and left behind when chapter/ was added on 2026-10-18. Two root lists in one
# file is how that happens, so there is now one.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}" || exit 1

# Fail closed on a mis-resolved root: an empty file set would otherwise be
# indistinguishable from a clean tree.
if [ ! -d "${REPO_ROOT}/harness" ] || [ ! -d "${REPO_ROOT}/scripts" ]; then
  echo "scripts/lint: ${REPO_ROOT} is not the tla-puzzles root (no harness/ + scripts/)." >&2
  exit 2
fi

# drill/ was added 2026-10-14 with bead tla-t9de, because drill/drill.sh is the
# one script here a learner runs every day and it was getting no shellcheck at
# all. Widening the root surfaced exactly one finding, a false SC2016 on a
# markdown format string in drill/temporal/runs-table.sh, closed with a
# per-site disable and its reason.
# WIDENED 2026-10-18. swipe/level0/bake.sh carries a bash shebang and had never
# been shellchecked, found by the tla-7xql.10 author while editing it. That is
# the same shape as harness/test-spelling.sh never reading swipe/, found three
# days earlier: a tree accumulates shell for a while before anybody checks that
# the gate covers it.
#
# Rather than add the one root, every tracked file with a shell shebang was
# checked by hand first. All five uncovered roots came back clean, so widening
# cost nothing and the narrow fix would have left four more holes:
#
# (Note for whoever edits this block: do not start a comment line with the
# word shellcheck. It parses as a directive and raises SC1072 and SC1073. This
# comment did exactly that on its first draft, with the hazard already written
# down in .claude/rules/dispatched-agents.md.)
#
#   swipe       1 file    completion  1 file    chapter    2 files
#   exercises  17 files   sources    24 files
#
# .beads/ stays out. Its 5 scripts are the tracker's own, not this project's,
# and they arrive and change with bd rather than with anything here. Confirmed
# 2026-10-21: all 5 carry a shell shebang, all 5 are shellcheck-clean, and the
# header of each one reads "This section is managed by beads", so a future
# finding in them would not be ours to fix.
#
# WIDENED 2026-10-21, bead tla-d64i. core-language-docs/ holds the TLA+
# language reference and one shell file, core-language-docs/snippets/run-all.sh,
# which runs that tree's modules against the exit codes and state counts the
# pages quote. Seven more pages land under bead tla-9y4s and each may bring a
# runner. Enrolled the day after the tree appeared rather than waiting for
# tla-9y4s.9, since the thing this gate keeps learning is that a tree collects
# shell for a while before anybody checks the gate reads it.
#
# WIDENED 2026-10-25, bead tla-9bnj. probe/ holds the transfer probe's runner
# and its oracle-fetch script, two shell files, and it was enrolled in the same
# commit that created the tree rather than after the fact. Re-scanned every
# tracked top-level tree before adding it, the way tla-d64i did: probe/ was the
# only uncovered one, and it was already shellcheck clean. So this is the
# narrow fix the three-for-three caution warns about, and the scan is what says
# it is safe this time rather than a guess that it is.
LINT_ROOTS=(scripts harness drill recall swipe completion chapter exercises sources core-language-docs probe)

# root:floor. ADDED 2026-10-21, bead tla-d64i, and the reason is that this gate
# did not have them. It had one global check further down, refusing to report
# success over an empty FILES array, and that only fires when EVERY root
# resolves to nothing. A typo in one root silently drops that root's files and
# the run stays green on the other eight.
#
# harness/test-spelling.sh has carried per-root floors since 2026-10-14, and
# .claude/rules/dispatched-agents.md states that BOTH gates carry them. That
# was true of one of them. Found while adding a tenth root here.
#
# A floor asserts the root is still being walked, not how big it has grown, so
# each one sits well under the count measured on 2026-10-21:
# scripts 23, harness 63, drill 9, recall 1, swipe 7, completion 1, chapter 2,
# exercises 17, sources 24, core-language-docs 1. Total 148.
#
# Three roots hold exactly one shell file, so their floor is 1 and it is doing
# real work: those are precisely the roots a typo would silently empty.
LINT_FLOORS=(
  "scripts:15"
  "harness:40"
  "drill:5"
  "recall:1"
  "swipe:4"
  "completion:1"
  "chapter:2"
  "exercises:10"
  "sources:15"
  "core-language-docs:1"
  # probe/ carries 2 shell files on 2026-10-25, the runner and the fetch
  # script. The floor is 1 because it asserts the root is still walked rather
  # than how big it has grown, and harness/probe-gate.sh separately asserts
  # that both of those two files exist and are executable.
  "probe:1"
)

LIST_ONLY=0
declare -a EXPLICIT=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --list) LIST_ONLY=1 ;;
    -h|--help)
      sed -n '2,22p' "${BASH_SOURCE[0]}"
      exit 0
      ;;
    *) EXPLICIT+=("$1") ;;
  esac
  shift
done

if ! command -v shellcheck >/dev/null 2>&1; then
  echo "scripts/lint: shellcheck is not installed." >&2
  echo "  Install it, then re-run: bash scripts/bootstrap" >&2
  exit 2
fi

declare -a FILES=()

if [ "${#EXPLICIT[@]}" -gt 0 ]; then
  FILES=("${EXPLICIT[@]}")
else
  # Shebang-selected. `read -r -d ''` over a NUL-delimited find keeps paths
  # with spaces intact and avoids a pipe into the loop (a pipe would also put
  # the loop in a subshell, so FILES would come back empty).
  while IFS= read -r -d '' f; do
    first=""
    IFS= read -r first <"$f" || true
    case "$first" in
      '#!'*sh*) FILES+=("$f") ;;
    esac
  done < <(find "${LINT_ROOTS[@]}" -type f -print0)
fi

if [ "${#FILES[@]}" -eq 0 ]; then
  echo "scripts/lint: no shell files found under: ${LINT_ROOTS[*]}" >&2
  echo "  Refusing to report success over an empty set." >&2
  exit 2
fi

# ONE CHECK PER ROOT, never one over the total. The empty-set check above only
# fires when every root resolves to nothing, so it cannot tell "sources/ is
# covered" from "sources/ silently dropped out of the find". Skipped when the
# caller named files explicitly, since that set is deliberately not the roots.
if [ "${#EXPLICIT[@]}" -eq 0 ]; then
  floor_failures=0
  for entry in "${LINT_FLOORS[@]}"; do
    root="${entry%%:*}"
    floor="${entry#*:}"
    n=0
    for f in "${FILES[@]}"; do
      case "$f" in "$root"/*) n=$((n + 1)) ;; esac
    done
    if [ "$n" -lt "$floor" ]; then
      echo "scripts/lint: found only $n shell file(s) under $root/ (floor $floor)." >&2
      echo "  The gate is not covering that root. Fix the root list, or lower the" >&2
      echo "  floor and say in a comment what moved." >&2
      floor_failures=$((floor_failures + 1))
    fi
  done
  if [ "$floor_failures" -gt 0 ]; then
    echo "scripts/lint: $floor_failures root(s) below floor. Refusing to report success." >&2
    exit 2
  fi
fi

if [ "$LIST_ONLY" = "1" ]; then
  printf '%s\n' "${FILES[@]}" | sort
  exit 0
fi

echo "scripts/lint: shellcheck ${#FILES[@]} shell file(s) under ${LINT_ROOTS[*]}"
echo

set +e
shellcheck "${FILES[@]}"
rc=$?
set -e

echo
if [ "$rc" -eq 0 ]; then
  echo "OK: shellcheck clean over ${#FILES[@]} file(s)"
else
  echo "FAILED: shellcheck reported findings (rc=${rc}) over ${#FILES[@]} file(s)" >&2
fi
exit "$rc"
