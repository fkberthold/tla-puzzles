#!/usr/bin/env bash
# scripts/server — serve the curriculum site locally with live reload.
#
# Usage:
#   bash scripts/server                  # build docs/, then mkdocs serve
#   bash scripts/server --no-build       # skip the docs/ regeneration
#   bash scripts/server -- <mkdocs args> # e.g. -- -a 0.0.0.0:9000
#
# ---------------------------------------------------------------------------
# THE BUILD STEP IS NOT OPTIONAL ON A COLD CHECKOUT
#
# docs/ is GENERATED and gitignored — scripts/build-docs.sh assembles it from
# module-docs/ and the per-puzzle READMEs. `mkdocs serve` alone on a fresh
# clone serves an empty or stale tree, so this script regenerates first.
#
# Corollary, and the reason it is worth stating here: never hand-edit docs/.
# The next build destroys the edit. Edit module-docs/ instead.
#
# mkdocs serve watches docs/, so a source change under module-docs/ needs
# another scripts/build-docs.sh run to show up. --no-build exists for the
# common case where you are iterating on mkdocs.yml or on the theme.
# ---------------------------------------------------------------------------

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}" || exit 1

DO_BUILD=1
declare -a MKDOCS_ARGS=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --no-build) DO_BUILD=0 ;;
    --) shift; MKDOCS_ARGS=("$@"); break ;;
    -h|--help) sed -n '2,8p' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) MKDOCS_ARGS+=("$1") ;;
  esac
  shift
done

if ! command -v mkdocs >/dev/null 2>&1; then
  echo "scripts/server: mkdocs is not installed." >&2
  echo "  Run: bash scripts/setup   (pip install -r docs-requirements.txt)" >&2
  exit 2
fi

if [ "$DO_BUILD" = "1" ]; then
  echo "scripts/server: regenerating docs/ from module-docs/ + puzzle READMEs"
  bash scripts/build-docs.sh
  echo
fi

echo "scripts/server: mkdocs serve ${MKDOCS_ARGS[*]}"
exec mkdocs serve "${MKDOCS_ARGS[@]}"
