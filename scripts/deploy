#!/usr/bin/env bash
# scripts/deploy — publish the curriculum site by hand.
#
# Usage:
#   bash scripts/deploy          # explains the situation and refuses
#   bash scripts/deploy --yes    # build docs/, then mkdocs gh-deploy
#
# ===========================================================================
# READ THIS BEFORE USING IT: THIS IS NOT HOW THE SITE NORMALLY DEPLOYS.
#
# The live deployment path is .github/workflows/pages.yml, which fires on
# every push to main. It runs scripts/build-docs.sh, then `mkdocs build`, then
# publishes ./site through actions/upload-pages-artifact +
# actions/deploy-pages. That path serves the site straight from the Actions
# artifact — it does NOT use a gh-pages branch, and as of 2026-08-07 origin
# has no gh-pages branch at all (`git ls-remote --heads origin` returns only
# refs/heads/main).
#
# `mkdocs gh-deploy` publishes by FORCE-PUSHING a gh-pages branch. Against
# this repo that would create a branch nothing serves from, so the likely
# outcome is a deploy that appears to succeed and changes nothing visible —
# and if GitHub Pages is ever repointed at the branch, two publishers would
# then be fighting over the same site.
#
# Hence the --yes guard. This script is the manual fallback for the day the
# workflow is broken and the site has to go out anyway; it is not the routine
# path, and it force-pushes, so it does not run by accident.
# ===========================================================================

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}" || exit 1

CONFIRMED=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --yes|-y) CONFIRMED=1 ;;
    -h|--help) sed -n '2,28p' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "scripts/deploy: unknown option '$1' (try --help)" >&2; exit 2 ;;
  esac
  shift
done

if [ "$CONFIRMED" != "1" ]; then
  sed -n '7,28p' "${BASH_SOURCE[0]}" >&2
  echo >&2
  echo "scripts/deploy: refusing without --yes." >&2
  echo "  Routine deploys happen by pushing to main (.github/workflows/pages.yml)." >&2
  exit 2
fi

if ! command -v mkdocs >/dev/null 2>&1; then
  echo "scripts/deploy: mkdocs is not installed. Run: bash scripts/setup" >&2
  exit 2
fi

echo "scripts/deploy: regenerating docs/"
bash scripts/build-docs.sh

echo "scripts/deploy: mkdocs gh-deploy (force-pushes gh-pages)"
exec mkdocs gh-deploy
