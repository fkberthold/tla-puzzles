#!/usr/bin/env bash
# scripts/setup — make a fresh checkout ready to run.
#
# Installs the two things this project owns:
#   1. The PINNED TLA+ toolchain (tla2tools.jar) plus the ~/bin/tlc and
#      ~/bin/pcal wrappers the harness and the curriculum both call.
#   2. The docs toolchain, from docs-requirements.txt.
#
# System-level prerequisites (a JRE, curl, python3, shellcheck) are
# scripts/bootstrap's job. This script checks for them and points there.
#
# Usage:
#   bash scripts/setup             # install / repair
#   bash scripts/setup --check     # report what WOULD change; touch nothing
#   bash scripts/setup --no-docs   # TLA+ toolchain only
#
# Idempotent: with the pinned jar already installed and reporting the pinned
# version, the download is skipped entirely.
#
# ===========================================================================
# THE PIN, AND WHY IT IS A PIN
#
# Canonical TLC for this project is v1.8.0 "The Clarke release", chosen
# 2026-08-07. .github/workflows/verify-puzzles.yml pins the same release and
# asserts the same version string; this script mirrors it so local and CI
# cannot drift. Change one, change both, and re-verify the V2-PLAN.md §5
# constants (bead tla-wl7) — they were measured against a specific build, so
# a version move turns every one of them back into a hypothesis.
#
# NEVER write `releases/latest/download/`. GitHub's `latest` SKIPS
# prereleases, and v1.8.0 is flagged prerelease, so `latest` silently resolves
# to v1.7.4 — published 2024-08-05. That is how CI ran a 2024 build against
# 2026 constants without anything failing loudly (bead tla-5b4).
#
# THAT TRAP ALSO LIVED IN THE DOCS, and is fixed (bead tla-urv, reported by
# tla-xme): scripts/build-docs.sh used to emit `releases/latest/download` into
# the learner install instructions. It now reads TLA_RELEASE out of THIS FILE
# — the line below is the single source for the docs string — and
# scripts/cibuild phase 1 asserts no copy has drifted.
#
# THE DIGEST IS THE REAL PIN (bead tla-yvky). A tag names one artifact only
# if nobody rebinds it, and v1.8.0 got rebound three times in 22 days once
# GitHub flagged it prerelease. CI went red on 2026-08-13 checking a version
# the tag had stopped serving, and stayed red 15 days. So the pin moved to a
# release this repo controls, plus its sha256, and the install checks the
# digest instead of trusting the tag. TLA_JAR_URL and TLA_JAR_SHA256 below
# default to the pinned values and honor an environment override, which is
# the seam harness/test-toolchain-pin.sh uses to drive the mismatch check
# offline against a file:// URL.
# ===========================================================================

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}" || exit 1

TLA_RELEASE="tla2tools-v1.8.0-20260731"
TLA_JAR_SHA256_PIN="e22f8ffb4bacdea0a871f444dd94fe5fb0d8013b3388ae39e82e26f852c735d5"
TLA_JAR_URL="${TLA_JAR_URL:-https://github.com/fkberthold/tla-puzzles/releases/download/${TLA_RELEASE}/tla2tools.jar}"
TLA_JAR_SHA256="${TLA_JAR_SHA256:-$TLA_JAR_SHA256_PIN}"
# Asserted, not logged. A pin nobody checks is how the drift went unnoticed.
EXPECT_TLC="2026.07.31"
# Byte size of the pinned asset, confirmed against the release on 2026-08-07.
# Guards against a truncated download and against an HTML error page landing
# where a jar should be. The sha256 check below is the real gate. This is a
# cheap early guard in front of it.
EXPECT_BYTES=4486015

LIB_DIR="${HOME}/lib"
BIN_DIR="${HOME}/bin"
JAR="${LIB_DIR}/tla2tools.jar"

CHECK_ONLY=0
DO_DOCS=1
while [ "$#" -gt 0 ]; do
  case "$1" in
    --check)   CHECK_ONLY=1 ;;
    --no-docs) DO_DOCS=0 ;;
    -h|--help)
      sed -n '2,20p' "${BASH_SOURCE[0]}"
      exit 0
      ;;
    *)
      echo "scripts/setup: unknown option '$1' (try --help)" >&2
      exit 2
      ;;
  esac
  shift
done

say()  { printf 'setup: %s\n' "$*"; }
warn() { printf 'setup: %s\n' "$*" >&2; }
die()  { printf 'setup: ERROR — %s\n' "$*" >&2; exit 1; }

# --- prerequisites ---------------------------------------------------------
for tool in java curl sha256sum; do
  command -v "$tool" >/dev/null 2>&1 || die "'$tool' not found. Run: bash scripts/bootstrap"
done

# --- is the pinned jar already installed? ----------------------------------
# Ask the jar its own version rather than trusting the file's presence. Note
# the here-string: a live pipe into grep -q returns 141 under pipefail and
# would report a PRESENT version as ABSENT (bead tla-kr9).
jar_reports_pin() {
  local out
  [ -f "$JAR" ] || return 1
  out="$(java -cp "$JAR" tlc2.TLC 2>&1 || true)"
  grep -qF "TLC2 Version ${EXPECT_TLC}" <<<"$out"
}

NEED_JAR=1
if jar_reports_pin; then
  NEED_JAR=0
fi

if [ "$CHECK_ONLY" = "1" ]; then
  if [ "$NEED_JAR" = "0" ]; then
    say "jar: already at the pin (TLC2 ${EXPECT_TLC}) — nothing to do"
  else
    say "jar: WOULD install ${TLA_RELEASE} (TLC2 ${EXPECT_TLC}) into ${JAR}"
    if [ -f "$JAR" ]; then
      say "jar: WOULD back up the existing ${JAR} first"
    fi
  fi
  say "wrappers: WOULD (re)write ${BIN_DIR}/tlc and ${BIN_DIR}/pcal"
  if [ "$DO_DOCS" = "1" ]; then
    say "docs: WOULD pip install -r docs-requirements.txt"
  fi
  exit 0
fi

mkdir -p "$LIB_DIR" "$BIN_DIR"

# --- install the pinned jar ------------------------------------------------
if [ "$NEED_JAR" = "0" ]; then
  say "jar already at the pin (TLC2 ${EXPECT_TLC}) — skipping download"
else
  # BACK UP FIRST. Old nightly builds are NOT re-downloadable: they are not
  # published as release assets, so an overwritten nightly is gone for good.
  # Every empirical constant in V2-PLAN.md §5 was measured against whatever
  # jar is sitting there right now, so the backup is the only way to reproduce
  # those measurements after the swap.
  if [ -f "$JAR" ]; then
    backup="${JAR}.backup-$(date +%Y%m%d-%H%M%S)"
    if [ -e "$backup" ]; then
      die "backup path ${backup} already exists — refusing to clobber it"
    fi
    cp -p "$JAR" "$backup"
    say "backed up the existing jar to ${backup}"
    say "  (it is NOT re-downloadable — keep it until bead tla-wl7 closes)"
  fi

  tmp="$(mktemp "${LIB_DIR}/tla2tools.jar.download.XXXXXX")"
  # shellcheck disable=SC2064  # expand $tmp now, at trap-registration time
  trap "rm -f '$tmp'" EXIT

  say "downloading ${TLA_RELEASE} from ${TLA_JAR_URL}"
  curl -fsSL -o "$tmp" "$TLA_JAR_URL" || die "download failed"

  actual_bytes="$(wc -c <"$tmp" | tr -d ' ')"
  if [ "$actual_bytes" != "$EXPECT_BYTES" ]; then
    die "downloaded ${actual_bytes} bytes, expected ${EXPECT_BYTES}. Refusing to install."
  fi

  # The digest is the real check. A tag can get rebound out from under a
  # download; a sha256 cannot, so this is the assertion that actually catches
  # drift (bead tla-yvky). Named both ways on a mismatch, and nothing gets
  # installed.
  actual_sha256="$(sha256sum "$tmp")"
  actual_sha256="${actual_sha256%% *}"
  if [ "$actual_sha256" != "$TLA_JAR_SHA256" ]; then
    die "sha256 mismatch. wanted ${TLA_JAR_SHA256}, got ${actual_sha256}. Refusing to install."
  fi

  mv "$tmp" "$JAR"
  trap - EXIT
  say "installed ${JAR} (${EXPECT_BYTES} bytes, sha256 ${TLA_JAR_SHA256})"
fi

# --- wrappers --------------------------------------------------------------
# ~/bin/tlc keeps the `-pcal` dispatch. That is NOT decoration: `tlc -pcal` is
# the documented project convention (README.md, scripts/build-docs.sh, and the
# T0a/T0b/T0e/J06/T47 puzzle READMEs all instruct it). CI's wrapper omits it
# and gets away with it only because verify-puzzle.sh calls `pcal` directly.
#
# ~/bin/pcal is installed alongside for CI parity AND because verify-puzzle.sh
# invokes a bare `pcal`. Without it that resolves to whatever other tlaplus
# build happens to be on PATH — translating PlusCal with one build and
# model-checking it with another is exactly the drift this pin exists to close.
#
# `-repl` was added 2026-10-20 (bead tla-tyqy). tlc2.REPL has been in the
# pinned jar all along and the wrapper did not reach it. Three constraints on
# the body below, and each one has already been hit:
#
#   1. THE BODY CANNOT CONTAIN A SINGLE QUOTE. It is a single-quoted string,
#      which is what keeps $HOME and $@ unexpanded until the wrapper runs. So
#      the usage text spells out "does not" and "cannot" rather than
#      contracting them, and names a primed variable in words.
#   2. BARE `tlc` MUST STILL REACH tlc2.TLC. The pin assertion below runs the
#      wrapper with no arguments and reads the version line out of it, so a
#      usage-on-no-arguments branch here breaks the assertion 40 lines down.
#   3. `-h` AND `-help` MUST STILL REACH TLC. Both print TLC's own option
#      list, measured on this build. The wrapper only intercepts them after
#      `-repl`, where tlc2.REPL would otherwise evaluate `-h` as an expression
#      and report `Unknown operator: h`.
#
# WHY THE USAGE TEXT SAYS "LEVEL 0" OUT LOUD. tlc2.REPL splits three ways on
# this build, and only two of the three are loud. A variable or a prime
# reports `Unknown operator`. A temporal operator reports a parse error.
# `ENABLED (1 = 1)` and `UNCHANGED 1` both return TRUE, because a constant
# expression is trivially enabled and trivially unchanged. That third case is
# a false TRUE handed to the exact reader this curriculum teaches, so the
# limit is printed rather than left to be discovered.
install_wrapper() {
  local path="$1" body="$2"
  if [ -f "$path" ] && ! grep -qF "tla-puzzles pinned wrapper" "$path"; then
    local backup
    backup="${path}.backup-$(date +%Y%m%d-%H%M%S)"
    cp -p "$path" "$backup"
    say "backed up the pre-existing $(basename "$path") to ${backup}"
  fi
  printf '%s\n' "$body" >"$path"
  chmod +x "$path"
  say "wrote ${path}"
}

# shellcheck disable=SC2016  # single quotes are load-bearing: $HOME and $@ must
# reach the wrapper file unexpanded, to be resolved when the wrapper runs.
install_wrapper "${BIN_DIR}/tlc" '#!/usr/bin/env bash
# tla-puzzles pinned wrapper — written by scripts/setup. Do not hand-edit.
JAR="$HOME/lib/tla2tools.jar"
JVM_OPTS="-XX:+UseParallelGC"

repl_usage() {
    cat >&2 <<"USAGE"
tlc -repl: a prompt for level 0 TLA+ expressions, and nothing above level 0.

  tlc -repl             start the prompt
  tlc -repl "1 + 1"     evaluate one expression, print the value, exit

WHAT IT REACHES

Arithmetic, sets, functions, records, tuples and CHOOSE, plus every operator
in the standard modules. Cardinality and Len need no EXTENDS line. LET binds
an operator for the one expression: LET D(n) == n * 2 IN D(21).

WHAT IT REFUSES

A level 0 expression has no variable, no prime and no temporal operator. A
bare x reports "Unknown operator", and so does a primed variable. A temporal
operator reports a parse error. The state level and the action level are both
above this prompt, so no invariant over a variable can be evaluated here.

WHAT IT ANSWERS VACUOUSLY

ENABLED (1 = 1) returns TRUE, and so does UNCHANGED 1. A constant expression
is trivially enabled and trivially unchanged, so the prompt answers rather
than refuses. The answer says nothing about any action. The two refusals
above are loud. This one is silent, so do not read it as a check.

IT CANNOT SEE A MODULE IN THE WORKING DIRECTORY

The prompt builds its own module with a fixed EXTENDS list and no hook to add
to it. An operator from your own module reports "Unknown operator". Model
check the module with tlc to evaluate one.
USAGE
}

if [ "$1" = "-pcal" ]; then
    shift
    exec java $JVM_OPTS -cp "$JAR" pcal.trans "$@"
elif [ "$1" = "-repl" ]; then
    shift
    case "${1:-}" in
        -h|-help|--help)
            repl_usage
            exit 0
            ;;
    esac
    if [ "$#" -gt 1 ]; then
        echo "tlc -repl: quote the expression as one argument, or pass none." >&2
        echo "  tlc -repl \"1 + 1\"" >&2
        exit 2
    fi
    if [ "$#" -eq 0 ]; then
        echo "tlc -repl: LEVEL 0 ONLY. No variable, no prime, no temporal operator." >&2
        echo "  ENABLED and UNCHANGED return TRUE over any constant, which is vacuous." >&2
        echo "  Run \"tlc -repl -h\" before you trust an answer from either." >&2
    fi
    exec java $JVM_OPTS -cp "$JAR" tlc2.REPL "$@"
else
    exec java $JVM_OPTS -cp "$JAR" tlc2.TLC "$@"
fi'

# shellcheck disable=SC2016  # as above — the wrapper resolves $HOME at run time.
install_wrapper "${BIN_DIR}/pcal" '#!/usr/bin/env bash
# tla-puzzles pinned wrapper — written by scripts/setup. Do not hand-edit.
exec java -XX:+UseParallelGC -cp "$HOME/lib/tla2tools.jar" pcal.trans "$@"'

case ":${PATH}:" in
  *":${BIN_DIR}:"*) ;;
  *) warn "NOTE: ${BIN_DIR} is not on your PATH — add it, or tlc/pcal will not resolve." ;;
esac

# --- assert the pin ---------------------------------------------------------
tlc_out="$("${BIN_DIR}/tlc" 2>&1 || true)"
if ! grep -qF "TLC2 Version ${EXPECT_TLC}" <<<"$tlc_out"; then
  warn "the installed toolchain does not report TLC2 Version ${EXPECT_TLC}:"
  grep -m1 "TLC2 Version" <<<"$tlc_out" >&2 || warn "  (no version line at all)"
  die "pin assertion failed"
fi
say "pin asserted: TLC2 Version ${EXPECT_TLC} (${TLA_RELEASE})"

# --- docs toolchain --------------------------------------------------------
if [ "$DO_DOCS" = "1" ]; then
  command -v python3 >/dev/null 2>&1 || die "python3 not found. Run: bash scripts/bootstrap"
  # --user outside a virtualenv (this is where mkdocs already lives here);
  # plain install inside one, where --user is an error.
  pip_args=(install -r docs-requirements.txt)
  if [ -z "${VIRTUAL_ENV:-}" ] && [ "$(id -u)" != "0" ]; then
    pip_args=(install --user -r docs-requirements.txt)
  fi
  say "python3 -m pip ${pip_args[*]}"
  python3 -m pip "${pip_args[@]}" || die "pip install failed"
fi

echo
say "done. Verify with:  bash scripts/test --fast"
